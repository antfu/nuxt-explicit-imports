{
  "name": "nuxt-explicit-imports",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "description": "Migrate a Nuxt app away from auto-imports, step by step, with agent skills, a codemod and a warn mode",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/nuxt-explicit-imports#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/nuxt-explicit-imports.git"
  },
  "bugs": "https://github.com/antfu/nuxt-explicit-imports/issues",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "auto-imports",
    "codemod",
    "unimport",
    "agent-skills"
  ],
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/module.mjs"
  },
  "types": "./dist/module.d.mts",
  "bin": {
    "nuxt-explicit-imports": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "eval": "tsx eval/run.ts",
    "knip": "knip",
    "lint": "eslint --cache",
    "prepack": "nr build",
    "release": "bumpp",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills sync -y --no-frozen-lockfile"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:prod",
    "@vue/compiler-sfc": "catalog:prod",
    "cac": "catalog:prod",
    "consola": "catalog:prod",
    "magic-string": "catalog:prod",
    "mlly": "catalog:prod",
    "oxc-parser": "catalog:prod",
    "oxc-walker": "catalog:prod",
    "pathe": "catalog:prod",
    "picomatch": "catalog:prod",
    "tinyglobby": "catalog:prod",
    "unimport": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/skills": "catalog:agentic",
    "@antfu/utils": "catalog:inlined",
    "@anthropic-ai/claude-agent-sdk": "catalog:testing",
    "@types/node": "catalog:types",
    "@types/picomatch": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "knip": "catalog:cli",
    "nano-staged": "catalog:cli",
    "nuxt": "catalog:frontend",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills": "catalog:agentic",
    "taze": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vue-tsc": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  }
}
