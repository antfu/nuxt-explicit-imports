+import type { CartLine } from '#shared/types/cart'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const lines = body?.lines ?? []
+  const valid = Array.isArray(lines) && lines.length > 0 && lines.every(line =>
+    typeof line?.slug === 'string'
+    && findProduct(line.slug)
+    && Number.isInteger(line.qty)
+    && line.qty > 0,
+  )
+  if (!valid)
+    throw createError({ statusCode: 400, statusMessage: 'Invalid order lines' })
+  const code = typeof body?.code === 'string' ? body.code : undefined
+  return createOrder(lines.map(({ slug, qty }) => ({ slug, qty })), code)
+})
