+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+
+const orders = new Map<string, Order>()
+
+/** Validates cart lines from a request body, throwing a 400 on anything malformed or unknown. */
+export function parseOrderLines(input: unknown): CartLine[] {
+  if (!Array.isArray(input) || input.length === 0)
+    throw createError({ statusCode: 400, statusMessage: 'Order must have at least one line' })
+  return input.map((line) => {
+    const slug = line?.slug
+    const qty = line?.qty
+    if (typeof slug !== 'string' || !findProduct(slug))
+      throw createError({ statusCode: 400, statusMessage: `Unknown product: ${String(slug)}` })
+    if (!Number.isInteger(qty) || qty < 1)
+      throw createError({ statusCode: 400, statusMessage: `Invalid quantity for ${slug}` })
+    return { slug, qty }
+  })
+}
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const order: Order = {
+    id: crypto.randomUUID(),
+    lines: lines.map(line => ({ ...line, name: findProduct(line.slug)!.name })),
+    ...computeQuote(lines, code),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
