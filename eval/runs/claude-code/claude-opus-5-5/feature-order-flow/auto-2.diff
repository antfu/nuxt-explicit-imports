   return `$${(cents / 100).toFixed(2)}`
 }
+
+/** Parses the server API money format back to cents: `19.99 USD` -> `1999`. */
+export function parseServerMoney(text: string): number {
+  return Math.round(Number.parseFloat(text) * 100)
+}
