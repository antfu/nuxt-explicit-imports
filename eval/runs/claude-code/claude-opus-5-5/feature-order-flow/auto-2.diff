@@ -0,0 +1,35 @@
+import { randomUUID } from 'node:crypto'
+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+
+/** In-memory order store. Orders are lost when the server restarts. */
+const orders = new Map<string, Order>()
+
+/** Validates cart lines; throws a 400 for unknown products or invalid quantities. */
+function validateLines(lines: unknown): CartLine[] {
+  if (!Array.isArray(lines) || lines.length === 0)
+    throw createError({ statusCode: 400, statusMessage: 'Order must contain at least one line' })
+  return lines.map((line) => {
+    const { slug, qty } = (line ?? {}) as Partial<CartLine>
+    if (typeof slug !== 'string' || !findProduct(slug))
+      throw createError({ statusCode: 400, statusMessage: `Unknown product: ${String(slug)}` })
+    if (typeof qty !== 'number' || !Number.isInteger(qty) || qty < 1)
+      throw createError({ statusCode: 400, statusMessage: `Invalid quantity for ${slug}` })
+    return { slug, qty }
+  })
+}
+
+export function createOrder(rawLines: unknown, code?: string): Order {
+  const lines = validateLines(rawLines)
+  const order: Order = {
+    id: randomUUID(),
+    ...computeQuote(lines, code),
+    lines: lines.map(line => ({ ...line, name: findProduct(line.slug)!.name })),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
