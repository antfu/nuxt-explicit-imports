diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..5b91129
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,44 @@
+<script setup lang="ts">
+import type { CartLine } from '#shared/types/cart'
+import { computed } from 'vue'
+import { createError, useFetch, useRoute } from '#imports'
+import { formatDiscount } from '~/utils/discount'
+import { formatMoney, parseServerMoney } from '~/utils/money'
+
+interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+const route = useRoute()
+const id = encodeURIComponent(String(route.params.id))
+const [{ data: order, error }, { data: lines }] = await Promise.all([
+  useFetch<Order>(`/api/orders/${id}`),
+  useFetch<(CartLine & { name: string })[]>(`/api/orders/${id}/lines`, { default: () => [] }),
+])
+if (error.value || !order.value)
+  throw createError({ statusCode: 404, statusMessage: 'Order not found', fatal: true })
+
+const subtotal = computed(() => formatMoney(parseServerMoney(order.value?.subtotal ?? '0')))
+const discount = computed(() => parseServerMoney(order.value?.discount ?? '0'))
+const total = computed(() => formatMoney(parseServerMoney(order.value?.total ?? '0')))
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in lines" :key="line.slug" class="order-line">
+        <span class="name">{{ line.name }}</span>
+        <span class="qty">x{{ line.qty }}</span>
+      </li>
+    </ul>
+    <p>Subtotal: <span id="order-subtotal">{{ subtotal }}</span></p>
+    <p v-if="discount">
+      Discount: <span id="order-discount">{{ formatDiscount(discount) }}</span>
+    </p>
+    <p>Total: <span id="order-total">{{ total }}</span></p>
+  </div>
+</template>
