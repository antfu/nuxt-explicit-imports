+import { createError, defineEventHandler, getRouterParam } from 'h3'
+import { findOrderLines } from '#server/utils/orders'
+
+/** The lines of a stored order, with product names. */
+export default defineEventHandler((event) => {
+  const lines = findOrderLines(getRouterParam(event, 'id') ?? '')
+  if (!lines)
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  return lines
+})
