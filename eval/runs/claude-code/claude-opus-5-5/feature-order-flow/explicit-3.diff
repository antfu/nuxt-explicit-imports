+import { defineEventHandler, readBody } from 'h3'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: unknown, code?: unknown }>(event)
+  return createOrder(body?.lines ?? [], body?.code)
+})
diff --git a/server/utils/orders.ts b/server/utils/orders.ts
new file mode 100644
index 0000000..51c7d3d
--- /dev/null
+++ b/server/utils/orders.ts
@@ -0,0 +1,58 @@
+import type { CartLine } from '#shared/types/cart'
+import type { Quote } from '#server/utils/quote'
+import { randomUUID } from 'node:crypto'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+export interface OrderLine extends CartLine {
+  name: string
+}
+
+/** Public order shape: same money format as the quote API. */
+export interface Order extends Quote {
+  id: string
+}
+
+interface StoredOrder {
+  order: Order
+  lines: OrderLine[]
+}
+
+const orders = new Map<string, StoredOrder>()
+
+/** Keeps only lines for known products with a positive integer quantity, merging duplicates. */
+function normalizeLines(input: unknown): OrderLine[] {
+  const result: OrderLine[] = []
+  if (!Array.isArray(input))
+    return result
+  for (const raw of input) {
+    const slug = typeof raw?.slug === 'string' ? raw.slug : ''
+    const qty = Number(raw?.qty)
+    const product = findProduct(slug)
+    if (!product || !Number.isInteger(qty) || qty <= 0)
+      continue
+    const existing = result.find(line => line.slug === slug)
+    if (existing)
+      existing.qty += qty
+    else
+      result.push({ slug, qty, name: product.name })
+  }
+  return result
+}
+
+export function createOrder(rawLines: unknown, code?: unknown): Order {
+  const lines = normalizeLines(rawLines)
+  const quote = computeQuote(lines, typeof code === 'string' ? code : undefined)
+  const order: Order = { id: randomUUID(), ...quote }
+  orders.set(order.id, { order, lines })
+  return { ...order }
+}
+
+export function findOrder(id: string): Order | undefined {
+  const stored = orders.get(id)
+  return stored && { ...stored.order }
+}
+
+export function findOrderLines(id: string): OrderLine[] | undefined {
+  return orders.get(id)?.lines.map(line => ({ ...line }))
+}
