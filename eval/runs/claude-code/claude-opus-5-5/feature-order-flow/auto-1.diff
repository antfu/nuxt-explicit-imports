new file mode 100644
index 0000000..7bb41c5
--- /dev/null
+++ b/server/utils/orders.ts
@@ -0,0 +1,48 @@
+import { randomUUID } from 'node:crypto'
+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderLine } from '#shared/types/order'
+
+interface StoredOrder {
+  id: string
+  lines: OrderLine[]
+  code?: string
+  amounts: QuoteCents
+}
+
+/** In-memory order store. Orders are lost when the server restarts. */
+const orders = new Map<string, StoredOrder>()
+
+/** Validates raw cart lines, throwing a 400 for anything that cannot be charged. */
+export function parseOrderLines(input: unknown): CartLine[] {
+  if (!Array.isArray(input) || input.length === 0)
+    throw createError({ statusCode: 400, statusMessage: 'Order must contain at least one line' })
+  return input.map((line) => {
+    const slug = line?.slug
+    const qty = line?.qty
+    if (typeof slug !== 'string' || !findProduct(slug))
+      throw createError({ statusCode: 400, statusMessage: `Unknown product: ${String(slug)}` })
+    if (!Number.isInteger(qty) || qty <= 0)
+      throw createError({ statusCode: 400, statusMessage: `Invalid quantity for ${slug}` })
+    return { slug, qty }
+  })
+}
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const order: StoredOrder = {
+    id: randomUUID(),
+    lines: lines.map(line => ({ slug: line.slug, name: findProduct(line.slug)?.name ?? line.slug, qty: line.qty })),
+    code,
+    amounts: computeQuoteCents(lines, code),
+  }
+  orders.set(order.id, order)
+  return toOrderResponse(order)
+}
+
+export function getOrder(id: string): Order | undefined {
+  const order = orders.get(id)
+  return order && toOrderResponse(order)
+}
+
+function toOrderResponse(order: StoredOrder): Order {
+  return { id: order.id, lines: order.lines, ...formatQuote(order.amounts) }
+}
