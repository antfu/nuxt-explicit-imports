@@ -0,0 +1,37 @@
+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+
+/** Orders kept in server memory, keyed by id. Lost on restart. */
+const orders = new Map<string, Order>()
+
+/** Validates cart lines from an untrusted request body. Returns `null` when invalid. */
+export function parseOrderLines(input: unknown): CartLine[] | null {
+  if (!Array.isArray(input) || input.length === 0)
+    return null
+  const lines: CartLine[] = []
+  for (const item of input) {
+    const slug = (item as Partial<CartLine> | null)?.slug
+    const qty = (item as Partial<CartLine> | null)?.qty
+    if (typeof slug !== 'string' || !findProduct(slug))
+      return null
+    if (typeof qty !== 'number' || !Number.isInteger(qty) || qty < 1)
+      return null
+    lines.push({ slug, qty })
+  }
+  return lines
+}
+
+/** Prices the lines with the same logic as the quote API and stores the order. */
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const order: Order = {
+    id: crypto.randomUUID(),
+    ...computeQuote(lines, code),
+    lines: lines.map(line => ({ ...line, name: findProduct(line.slug)?.name ?? line.slug })),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
