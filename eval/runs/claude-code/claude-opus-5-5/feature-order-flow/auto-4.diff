+import type { CartLine } from './cart'
+
+export interface OrderLine extends CartLine {
+  name: string
+}
+
+/** An order as returned by the orders API. Amounts use the server money format (`19.99 USD`). */
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
