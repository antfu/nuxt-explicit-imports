+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderLine } from '#shared/types/order'
+import { randomUUID } from 'node:crypto'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, Order>()
+
+/** Keeps only lines for known products with a positive integer quantity, merging duplicates. */
+function normalizeLines(lines: unknown): CartLine[] {
+  if (!Array.isArray(lines))
+    return []
+  const merged = new Map<string, number>()
+  for (const line of lines) {
+    const slug = typeof line?.slug === 'string' ? line.slug : ''
+    const qty = Number(line?.qty)
+    if (!findProduct(slug) || !Number.isInteger(qty) || qty <= 0)
+      continue
+    merged.set(slug, (merged.get(slug) ?? 0) + qty)
+  }
+  return [...merged].map(([slug, qty]) => ({ slug, qty }))
+}
+
+/** Prices the cart with the quote logic and stores the order in memory. Returns `undefined` for an empty cart. */
+export function createOrder(rawLines: unknown, code?: unknown): Order | undefined {
+  const lines = normalizeLines(rawLines)
+  if (!lines.length)
+    return undefined
+  const quote = computeQuote(lines, typeof code === 'string' ? code : undefined)
+  const orderLines: OrderLine[] = lines.map(line => ({ ...line, name: findProduct(line.slug)!.name }))
+  const order: Order = { id: randomUUID(), ...quote, lines: orderLines }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
