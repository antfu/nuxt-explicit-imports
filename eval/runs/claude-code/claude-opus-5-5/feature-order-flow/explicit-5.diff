@@ -0,0 +1,41 @@
+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderLine } from '#shared/types/order'
+import { randomUUID } from 'node:crypto'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, Order>()
+
+/** Keeps only lines for known products with a positive whole quantity, merging duplicates. */
+function normalizeLines(lines: unknown): OrderLine[] {
+  const result: OrderLine[] = []
+  if (!Array.isArray(lines))
+    return result
+  for (const line of lines as Partial<CartLine>[]) {
+    const product = typeof line?.slug === 'string' ? findProduct(line.slug) : undefined
+    const qty = Number(line?.qty)
+    if (!product || !Number.isInteger(qty) || qty <= 0)
+      continue
+    const existing = result.find(l => l.slug === product.slug)
+    if (existing)
+      existing.qty += qty
+    else
+      result.push({ slug: product.slug, name: product.name, qty })
+  }
+  return result
+}
+
+/** Creates and stores an order, charged at the same amounts as `POST /api/cart/quote`. Returns `undefined` for an empty cart. */
+export function createOrder(lines: unknown, code?: string): Order | undefined {
+  const orderLines = normalizeLines(lines)
+  if (!orderLines.length)
+    return undefined
+  const quote = computeQuote(orderLines.map(({ slug, qty }) => ({ slug, qty })), typeof code === 'string' ? code : undefined)
+  const order: Order = { id: randomUUID(), ...quote, lines: orderLines }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
