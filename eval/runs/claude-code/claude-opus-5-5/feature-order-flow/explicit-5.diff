+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { computed } from 'vue'
+import { createError, useFetch, useRoute } from '#imports'
+import { formatMoney, parseServerMoney } from '~/utils/money'
+
+const route = useRoute()
+const id = computed(() => String(route.params.id))
+const { data: order, error } = await useFetch<Order>(() => `/api/orders/${encodeURIComponent(id.value)}`)
+if (error.value)
+  throw createError({ statusCode: error.value.statusCode ?? 404, statusMessage: 'Order not found', fatal: true })
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }} × {{ line.qty }}
+      </li>
+    </ul>
+    <p>Subtotal: <span id="order-subtotal">{{ formatMoney(parseServerMoney(order.subtotal)) }}</span></p>
+    <p>Discount: <span id="order-discount">-{{ formatMoney(parseServerMoney(order.discount)) }}</span></p>
+    <p>Total: <span id="order-total">{{ formatMoney(parseServerMoney(order.total)) }}</span></p>
+  </div>
+</template>
