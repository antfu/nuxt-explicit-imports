+++ b/server/utils/orders.ts
@@ -0,0 +1,22 @@
+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+import { randomUUID } from 'node:crypto'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, Order>()
+
+/** Prices the lines with the authoritative quote and stores the order in memory. */
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const order: Order = {
+    id: randomUUID(),
+    ...computeQuote(lines, code),
+    lines: lines.map(line => ({ slug: line.slug, name: findProduct(line.slug)?.name ?? line.slug, qty: line.qty })),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
