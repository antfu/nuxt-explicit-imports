--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,34 @@
+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { computed } from 'vue'
+import { createError, useFetch, useRoute } from '#imports'
+import { formatDiscount } from '~/utils/discount'
+import { formatMoney, parseServerMoney } from '~/utils/money'
+
+const route = useRoute()
+const id = computed(() => String(route.params.id))
+const { data: order, error } = await useFetch<Order>(() => `/api/orders/${encodeURIComponent(id.value)}`)
+if (error.value)
+  throw createError({ statusCode: error.value.statusCode ?? 404, statusMessage: 'Order not found', fatal: true })
+
+const subtotalCents = computed(() => (order.value ? parseServerMoney(order.value.subtotal) : 0))
+const discountCents = computed(() => (order.value ? parseServerMoney(order.value.discount) : 0))
+const totalCents = computed(() => (order.value ? parseServerMoney(order.value.total) : 0))
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        <span class="name">{{ line.name }}</span>
+        <span class="qty">x{{ line.qty }}</span>
+      </li>
+    </ul>
+    <p>Subtotal: <span id="order-subtotal">{{ formatMoney(subtotalCents) }}</span></p>
+    <p v-if="discountCents">
+      Discount: <span id="order-discount">{{ formatDiscount(discountCents) }}</span>
+    </p>
+    <p>Total: <span id="order-total">{{ formatMoney(totalCents) }}</span></p>
+  </div>
+</template>
