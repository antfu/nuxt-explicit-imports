+/** An order as returned by `POST /api/orders` and `GET /api/orders/:id`. Amounts use the server money format. */
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
+
+export interface OrderLine {
+  slug: string
+  name: string
+  qty: number
+}
