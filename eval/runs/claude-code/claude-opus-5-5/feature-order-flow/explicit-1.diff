@@ -0,0 +1,21 @@
+import type { CartLine } from '#shared/types/cart'
+import { createError, defineEventHandler, readBody } from 'h3'
+import { findProduct } from '#server/utils/db'
+import { createOrder } from '#server/utils/orders'
+
+function isValidLine(line: unknown): line is CartLine {
+  if (!line || typeof line !== 'object')
+    return false
+  const { slug, qty } = line as Record<string, unknown>
+  return typeof slug === 'string' && !!findProduct(slug)
+    && typeof qty === 'number' && Number.isInteger(qty) && qty > 0
+}
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: unknown, code?: unknown }>(event)
+  const lines = body?.lines
+  if (!Array.isArray(lines) || !lines.length || !lines.every(isValidLine))
+    throw createError({ statusCode: 400, statusMessage: 'Invalid order lines' })
+  const code = typeof body?.code === 'string' ? body.code : undefined
+  return createOrder(lines, code)
+})
