+export interface OrderLine {
+  slug: string
+  name: string
+  qty: number
+}
+
+/** An order as returned by the orders API. Amounts use the server money format (`19.99 USD`). */
+export interface Order {
+  id: string
+  lines: OrderLine[]
+  subtotal: string
+  discount: string
+  total: string
+}
