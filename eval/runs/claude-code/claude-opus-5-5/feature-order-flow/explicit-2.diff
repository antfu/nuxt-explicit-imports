+import { createError, defineEventHandler, readBody } from 'h3'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: unknown, code?: string }>(event)
+  const order = createOrder(body?.lines, body?.code)
+  if (!order)
+    throw createError({ statusCode: 400, statusMessage: 'The order has no valid lines' })
+  return order
+})
