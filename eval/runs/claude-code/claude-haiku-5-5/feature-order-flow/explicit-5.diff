@@ -0,0 +1,16 @@
+import type { CartLine } from '#shared/types/cart'
+import { createError, defineEventHandler, readBody } from 'h3'
+import { placeOrder, UnknownProductError } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  try {
+    const order = placeOrder(body?.lines ?? [], body?.code)
+    return { id: order.id, subtotal: order.subtotal, discount: order.discount, total: order.total }
+  }
+  catch (error) {
+    if (error instanceof UnknownProductError)
+      throw createError({ statusCode: 400, statusMessage: error.message })
+    throw error
+  }
+})
