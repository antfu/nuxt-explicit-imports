+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderLine } from '#shared/types/order'
+import { randomUUID } from 'node:crypto'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+/** Orders live in server memory only, so they are lost on restart. */
+const orders = new Map<string, Order>()
+
+export class UnknownProductError extends Error {}
+
+/**
+ * Stores an order priced by the same quote logic as `/api/cart/quote`.
+ * Throws `UnknownProductError` when a line refers to a product that does not exist.
+ */
+export function placeOrder(lines: CartLine[], code?: string): Order {
+  if (!lines.length)
+    throw new UnknownProductError('The order has no lines')
+  const orderLines: OrderLine[] = lines.map((line) => {
+    const product = findProduct(line.slug)
+    if (!product)
+      throw new UnknownProductError(`Unknown product: ${line.slug}`)
+    return { slug: line.slug, name: product.name, qty: line.qty }
+  })
+  const order: Order = {
+    id: randomUUID(),
+    lines: orderLines,
+    ...computeQuote(lines, code),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
