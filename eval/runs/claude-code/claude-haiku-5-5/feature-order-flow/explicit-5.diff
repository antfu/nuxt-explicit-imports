+export interface OrderLine {
+  slug: string
+  name: string
+  qty: number
+}
+
+/** An order as the API returns it. Amounts use the server format, e.g. `19.99 USD`. */
+export interface Order {
+  id: string
+  lines: OrderLine[]
+  subtotal: string
+  discount: string
+  total: string
+}
