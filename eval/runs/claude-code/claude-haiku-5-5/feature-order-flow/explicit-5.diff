+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { useFetch, useRoute } from '#imports'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order, error } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+/** The API returns server amounts such as `19.99 USD`; the UI shows them as `$19.99`. */
+function uiMoney(serverAmount: string) {
+  return formatMoney(Math.round(Number.parseFloat(serverAmount) * 100))
+}
+</script>
+
+<template>
+  <div>
+    <h1>Order</h1>
+    <p v-if="error">
+      Order not found.
+    </p>
+    <template v-else-if="order">
+      <ul>
+        <li v-for="line in order.lines" :key="line.slug" class="order-line">
+          {{ line.name }} × {{ line.qty }}
+        </li>
+      </ul>
+      <p>Subtotal: <span id="order-subtotal">{{ uiMoney(order.subtotal) }}</span></p>
+      <p>Discount: <span id="order-discount">-{{ uiMoney(order.discount) }}</span></p>
+      <p>Total: <span id="order-total">{{ uiMoney(order.total) }}</span></p>
+    </template>
+  </div>
+</template>
