+import type { OrderReceipt } from '#shared/types/order'
+
+export default defineEventHandler(async (event): Promise<OrderReceipt> => {
+  const body = await readBody<{ lines?: unknown, code?: unknown }>(event)
+  const lines = parseOrderLines(body?.lines)
+  if (!lines)
+    throw createError({ statusCode: 400, statusMessage: 'Invalid lines' })
+  const code = typeof body.code === 'string' ? body.code : undefined
+  const { id, subtotal, discount, total } = createOrder(lines, code)
+  return { id, subtotal, discount, total }
+})
