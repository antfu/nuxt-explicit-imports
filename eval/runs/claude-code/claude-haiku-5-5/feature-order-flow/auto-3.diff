+import type { CartLine } from './cart'
+
+/** Amounts are formatted by the server, like the quote API: `19.99 USD`. */
+export interface OrderReceipt {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+export interface Order extends OrderReceipt {
+  lines: CartLine[]
+}
