+import { randomUUID } from 'node:crypto'
+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+
+/** Orders live in server memory only, so they are lost on restart. */
+const orders = new Map<string, Order>()
+
+/** Validates and normalizes the cart lines from a request body. Returns `undefined` when invalid. */
+export function parseOrderLines(input: unknown): CartLine[] | undefined {
+  if (!Array.isArray(input) || input.length === 0)
+    return undefined
+  const lines: CartLine[] = []
+  for (const line of input) {
+    if (!line || typeof line.slug !== 'string' || !Number.isInteger(line.qty) || line.qty < 1)
+      return undefined
+    lines.push({ slug: line.slug, qty: line.qty })
+  }
+  return lines
+}
+
+/** Stores an order with the amounts the server charges, computed with the same rules as the quote API. */
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const order: Order = { id: randomUUID(), lines, ...computeQuote(lines, code) }
+  orders.set(order.id, order)
+  return order
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
