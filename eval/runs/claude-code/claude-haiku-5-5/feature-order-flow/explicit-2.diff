+import type { CartLine } from '#shared/types/cart'
+import type { Quote } from '#server/utils/quote'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+export interface OrderLine extends CartLine {
+  name: string
+}
+
+export interface Order extends Quote {
+  id: string
+  lines: OrderLine[]
+}
+
+/** In-memory order store. Orders are lost on server restart. */
+const orders = new Map<string, Order>()
+
+/** Whether every line refers to a known product with a positive integer quantity. */
+export function isValidOrderLines(lines: unknown): lines is CartLine[] {
+  return Array.isArray(lines)
+    && lines.length > 0
+    && lines.every(line => findProduct(line?.slug) !== undefined && Number.isInteger(line.qty) && line.qty > 0)
+}
+
+/** Stores an order priced by the server, using the same computation as the quote API. */
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const quote = computeQuote(lines, code)
+  const order: Order = {
+    id: crypto.randomUUID(),
+    lines: lines.map(line => ({ slug: line.slug, qty: line.qty, name: findProduct(line.slug)?.name ?? line.slug })),
+    ...quote,
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
