+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { useFetch, useRoute } from '#imports'
+import { formatDiscount } from '~/utils/discount'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+/** Server amount `19.99 USD` -> UI amount `$19.99`. */
+function toUiMoney(serverAmount: string) {
+  return formatMoney(Math.round(Number.parseFloat(serverAmount) * 100))
+}
+
+/** Server discount `3.99 USD` -> UI discount `-$3.99`. */
+function toUiDiscount(serverAmount: string) {
+  return formatDiscount(Math.round(Number.parseFloat(serverAmount) * 100))
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }} <span class="qty">× {{ line.qty }}</span>
+      </li>
+    </ul>
+    <p>Subtotal: <span id="order-subtotal">{{ toUiMoney(order.subtotal) }}</span></p>
+    <p>Discount: <span id="order-discount">{{ toUiDiscount(order.discount) }}</span></p>
+    <p>Total: <span id="order-total">{{ toUiMoney(order.total) }}</span></p>
+  </div>
+  <p v-else id="order-not-found">
+    Order not found.
+  </p>
+</template>
