+<script setup lang="ts">
+import type { Order } from '#server/utils/orders'
+import { useRoute, useFetch } from '#app'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+/** The API returns amounts as `19.99 USD`; the UI shows them as `$19.99`. */
+function toUiMoney(amount: string): string {
+  return formatMoney(Math.round(Number.parseFloat(amount) * 100))
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }} × {{ line.qty }}
+      </li>
+    </ul>
+    <p>Subtotal: {{ toUiMoney(order.subtotal) }}</p>
+    <p>Discount: {{ toUiMoney(order.discount) }}</p>
+    <p>Total: <span id="order-total">{{ toUiMoney(order.total) }}</span></p>
+  </div>
+</template>
