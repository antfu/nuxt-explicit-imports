+import type { CartLine } from '#shared/types/cart'
+import type { Quote } from '#server/utils/quote'
+
+export interface Order extends Quote {
+  id: string
+  lines: CartLine[]
+}
+
+/** Orders kept in server memory, keyed by id. They are lost on restart. */
+const orders = new Map<string, Order>()
+
+export function saveOrder(id: string, lines: CartLine[], quote: Quote): Order {
+  const order: Order = { id, lines: lines.map(line => ({ ...line })), ...quote }
+  orders.set(id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
