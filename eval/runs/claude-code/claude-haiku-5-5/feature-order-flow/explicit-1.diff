+<script setup lang="ts">
+import type { CartLine } from '#shared/types/cart'
+import { computed } from 'vue'
+import { createError, useFetch, useRoute } from '#imports'
+import { useProducts } from '~/composables/useProducts'
+import { formatMoney } from '~/utils/money'
+
+interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: CartLine[]
+}
+
+const route = useRoute()
+const { data: order, error } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+if (error.value)
+  throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+
+const { data: products } = await useProducts()
+const names = computed(() => new Map(products.value.map(p => [p.slug, p.name])))
+
+/** The server formats amounts as `19.99 USD`; the UI shows them as `$19.99`. */
+function toUiMoney(serverAmount: string | undefined): string {
+  return formatMoney(Math.round(Number.parseFloat(serverAmount ?? '0') * 100))
+}
+
+const subtotal = computed(() => toUiMoney(order.value?.subtotal))
+const discount = computed(() => toUiMoney(order.value?.discount))
+const total = computed(() => toUiMoney(order.value?.total))
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        <span class="name">{{ names.get(line.slug) ?? line.slug }}</span>
+        <span class="qty">x{{ line.qty }}</span>
+      </li>
+    </ul>
+    <p>Subtotal: <span id="order-subtotal">{{ subtotal }}</span></p>
+    <p>Discount: <span id="order-discount">{{ discount }}</span></p>
+    <p>Total: <span id="order-total">{{ total }}</span></p>
+  </div>
+</template>
