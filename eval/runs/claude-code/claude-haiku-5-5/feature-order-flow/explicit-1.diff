+import type { CartLine } from '#shared/types/cart'
+import { randomUUID } from 'node:crypto'
+import { computeQuote, type Quote } from '#server/utils/quote'
+
+export interface StoredOrder extends Quote {
+  id: string
+  lines: CartLine[]
+}
+
+/** Orders live in server memory only; they are lost when the server restarts. */
+const orders = new Map<string, StoredOrder>()
+
+/** Quotes the lines server-side and stores the order with the amounts charged. */
+export function createOrder(lines: CartLine[], code?: string): StoredOrder {
+  const order: StoredOrder = { id: randomUUID(), lines, ...computeQuote(lines, code) }
+  orders.set(order.id, order)
+  return order
+}
+
+export function getOrder(id: string): StoredOrder | undefined {
+  return orders.get(id)
+}
