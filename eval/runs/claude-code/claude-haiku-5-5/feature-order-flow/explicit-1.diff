@@ -0,0 +1,14 @@
+import type { CartLine } from '#shared/types/cart'
+import { randomUUID } from 'node:crypto'
+import { createError, defineEventHandler, readBody } from 'h3'
+import { computeQuote } from '#server/utils/quote'
+import { saveOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  if (!Array.isArray(body?.lines))
+    throw createError({ statusCode: 400, statusMessage: 'lines must be an array' })
+  const quote = computeQuote(body.lines, body.code)
+  const order = saveOrder(randomUUID(), body.lines, quote)
+  return { id: order.id, subtotal: order.subtotal, discount: order.discount, total: order.total }
+})
