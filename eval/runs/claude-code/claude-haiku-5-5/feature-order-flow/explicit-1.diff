@@ -0,0 +1,16 @@
+import { createError, defineEventHandler, getRouterParam } from 'h3'
+import { findProduct } from '#server/utils/db'
+import { getOrder } from '#server/utils/orders'
+
+export default defineEventHandler((event) => {
+  const order = getOrder(getRouterParam(event, 'id') ?? '')
+  if (!order)
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+    lines: order.lines.map(line => ({ slug: line.slug, name: findProduct(line.slug)?.name ?? line.slug, qty: line.qty })),
+  }
+})
