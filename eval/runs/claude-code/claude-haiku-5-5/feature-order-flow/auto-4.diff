+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+
+const route = useRoute()
+const { data: order, error } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+// The API returns amounts as `19.99 USD`; the UI shows `$19.99`, so convert back to cents.
+const subtotal = computed(() => Math.round(Number.parseFloat(order.value?.subtotal ?? '0') * 100))
+const discount = computed(() => Math.round(Number.parseFloat(order.value?.discount ?? '0') * 100))
+const total = computed(() => Math.round(Number.parseFloat(order.value?.total ?? '0') * 100))
+</script>
+
+<template>
+  <div>
+    <h1>Order</h1>
+    <p v-if="error" id="order-error">
+      Order not found.
+    </p>
+    <template v-else-if="order">
+      <ul>
+        <li v-for="line in order.lines" :key="line.slug" class="order-line">
+          <span class="name">{{ line.name }}</span>
+          <span class="qty">x{{ line.qty }}</span>
+        </li>
+      </ul>
+      <section id="order-summary">
+        <p>Subtotal: <span id="order-subtotal">{{ formatMoney(subtotal) }}</span></p>
+        <p v-if="discount">
+          Discount: <span id="order-discount">{{ formatDiscount(discount) }}</span>
+        </p>
+        <p>Total: <span id="order-total">{{ formatMoney(total) }}</span></p>
+      </section>
+    </template>
+  </div>
+</template>
