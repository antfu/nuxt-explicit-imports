+/** Response of `POST /api/orders`. Amounts are server-formatted, like `/api/cart/quote`: `19.99 USD`. */
+export interface OrderSummary {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+/** Response of `GET /api/orders/:id`. */
+export interface Order extends OrderSummary {
+  lines: {
+    slug: string
+    name: string
+    qty: number
+  }[]
+}
