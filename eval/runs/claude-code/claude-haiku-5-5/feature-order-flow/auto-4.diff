+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderSummary } from '#shared/types/order'
+
+interface StoredOrder {
+  id: string
+  lines: CartLine[]
+  subtotal: string
+  discount: string
+  total: string
+}
+
+/** Orders live in server memory only, so they are lost when the server restarts. */
+const orders = new Map<string, StoredOrder>()
+
+/** Charges the cart with the same pricing as the quote API and stores the order. */
+export function placeOrder(lines: CartLine[], code?: string): OrderSummary {
+  const quote = computeQuote(lines, code)
+  const order: StoredOrder = {
+    id: crypto.randomUUID(),
+    lines: lines.map(({ slug, qty }) => ({ slug, qty })),
+    ...quote,
+  }
+  orders.set(order.id, order)
+  return { id: order.id, subtotal: order.subtotal, discount: order.discount, total: order.total }
+}
+
+export function getOrder(id: string): Order | undefined {
+  const order = orders.get(id)
+  if (!order)
+    return undefined
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+    lines: order.lines.map(line => ({
+      slug: line.slug,
+      name: findProduct(line.slug)?.name ?? line.slug,
+      qty: line.qty,
+    })),
+  }
+}
