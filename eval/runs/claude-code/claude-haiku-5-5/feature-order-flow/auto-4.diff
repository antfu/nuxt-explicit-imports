+import type { CartLine } from '#shared/types/cart'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: unknown, code?: unknown }>(event)
+  const lines = body?.lines
+  if (!Array.isArray(lines) || lines.length === 0)
+    throw createError({ statusCode: 400, statusMessage: 'Order needs at least one line' })
+  for (const line of lines) {
+    const { slug, qty } = (line ?? {}) as Partial<CartLine>
+    if (typeof slug !== 'string' || !findProduct(slug))
+      throw createError({ statusCode: 400, statusMessage: `Unknown product: ${String(slug)}` })
+    if (!Number.isInteger(qty) || (qty as number) < 1)
+      throw createError({ statusCode: 400, statusMessage: 'Quantity must be a positive integer' })
+  }
+  if (body.code != null && typeof body.code !== 'string')
+    throw createError({ statusCode: 400, statusMessage: 'Discount code must be a string' })
+  return placeOrder(lines as CartLine[], body.code ?? undefined)
+})
