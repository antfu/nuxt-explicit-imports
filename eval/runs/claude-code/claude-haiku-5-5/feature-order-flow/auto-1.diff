+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+
+/** Orders placed since the server started. Kept in memory only. */
+const orders = new Map<string, Order>()
+
+/** Stores an order with the amounts the server charges, computed exactly like the quote API. */
+export function saveOrder(lines: CartLine[], code?: string): Order {
+  const order: Order = {
+    id: crypto.randomUUID(),
+    lines: lines.map(line => ({ slug: line.slug, qty: line.qty })),
+    ...computeQuote(lines, code),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
