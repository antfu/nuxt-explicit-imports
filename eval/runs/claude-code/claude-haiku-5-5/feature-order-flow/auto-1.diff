+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+
+/** The server formats amounts as `19.99 USD`; the UI shows `$19.99`. */
+function toCents(amount: string): number {
+  return Math.round(Number.parseFloat(amount) * 100)
+}
+function productName(slug: string): string {
+  return products.value.find(p => p.slug === slug)?.name ?? slug
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        <span class="name">{{ productName(line.slug) }}</span>
+        <span class="qty">x{{ line.qty }}</span>
+      </li>
+    </ul>
+    <section id="order-summary">
+      <p>Subtotal: <span id="order-subtotal">{{ formatMoney(toCents(order.subtotal)) }}</span></p>
+      <p v-if="toCents(order.discount)">
+        Discount: {{ formatDiscount(toCents(order.discount)) }}
+      </p>
+      <p>Total: <span id="order-total">{{ formatMoney(toCents(order.total)) }}</span></p>
+    </section>
+  </div>
+  <p v-else>
+    Order not found.
+  </p>
+</template>
