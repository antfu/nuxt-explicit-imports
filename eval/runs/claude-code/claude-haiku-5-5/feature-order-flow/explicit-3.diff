+import type { CartLine } from '#shared/types/cart'
+import { createError, defineEventHandler, readBody } from 'h3'
+import { findProduct } from '#server/utils/db'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const lines = body?.lines
+  if (!Array.isArray(lines) || lines.length === 0)
+    throw createError({ statusCode: 400, statusMessage: 'Order needs at least one line' })
+  for (const line of lines) {
+    if (!findProduct(line?.slug ?? ''))
+      throw createError({ statusCode: 400, statusMessage: `Unknown product: ${line?.slug}` })
+    if (!Number.isInteger(line.qty) || line.qty < 1)
+      throw createError({ statusCode: 400, statusMessage: 'Quantity must be a positive integer' })
+  }
+  const { id, subtotal, discount, total } = createOrder(lines, body?.code)
+  return { id, subtotal, discount, total }
+})
