+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { computed } from 'vue'
+import { useRoute, useFetch, createError } from '#app'
+import { formatMoney } from '~/utils/money'
+import { formatDiscount } from '~/utils/discount'
+
+const route = useRoute()
+const { data: order, error } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+if (error.value)
+  throw createError({ statusCode: error.value.statusCode ?? 404, statusMessage: 'Order not found' })
+
+/** The API formats amounts as `19.99 USD`; the UI shows them as `$19.99`. */
+function toCents(amount: string): number {
+  return Math.round(Number.parseFloat(amount) * 100)
+}
+
+const discountCents = computed(() => toCents(order.value?.discount ?? '0 USD'))
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        <span class="name">{{ line.name }}</span>
+        <span class="qty">x{{ line.qty }}</span>
+      </li>
+    </ul>
+    <p>Subtotal: <span id="order-subtotal">{{ formatMoney(toCents(order.subtotal)) }}</span></p>
+    <p v-if="discountCents">
+      Discount: {{ formatDiscount(discountCents) }}
+    </p>
+    <p>Total: <span id="order-total">{{ formatMoney(toCents(order.total)) }}</span></p>
+  </div>
+</template>
