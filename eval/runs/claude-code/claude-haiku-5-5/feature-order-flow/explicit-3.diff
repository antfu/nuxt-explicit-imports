+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { computed } from 'vue'
+import { useFetch, useRoute } from '#imports'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+// The API sends amounts as `19.99 USD`; convert back to cents to show the UI format `$19.99`.
+const total = computed(() => formatMoney(Math.round(Number.parseFloat(order.value?.total ?? '0') * 100)))
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        <span class="name">{{ line.name }}</span>
+        <span class="qty">x{{ line.qty }}</span>
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ total }}</span></p>
+  </div>
+</template>
