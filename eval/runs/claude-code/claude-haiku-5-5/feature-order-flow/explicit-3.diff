+/** A line of a placed order, with the product name resolved at order time. */
+export interface OrderLine {
+  slug: string
+  name: string
+  qty: number
+}
+
+/** An order as returned by the API. Amounts use the quote format, e.g. `19.99 USD`. */
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
