+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+import { findProduct } from '#server/utils/db'
+import { formatMoney } from '#server/utils/money'
+import { priceLines } from '#server/utils/quote'
+
+/** In-memory order store. Orders are lost when the server restarts. */
+const orders = new Map<string, Order>()
+
+/** Stores an order priced by the server, and returns it. Lines must reference known products. */
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const amounts = priceLines(lines, code)
+  const order: Order = {
+    id: crypto.randomUUID(),
+    subtotal: formatMoney(amounts.subtotal),
+    discount: formatMoney(amounts.discount),
+    total: formatMoney(amounts.total),
+    lines: lines.map(line => ({
+      slug: line.slug,
+      name: findProduct(line.slug)?.name ?? line.slug,
+      qty: line.qty,
+    })),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
