+import type { CartLine } from '#shared/types/cart'
+import type { StoredOrder } from '#shared/types/order'
+
+/** Orders live in server memory only; they are lost when the server restarts. */
+const orders = new Map<string, StoredOrder>()
+
+/** Quotes the lines with the server's prices and stores the order. */
+export function createOrder(lines: CartLine[], code?: string): StoredOrder {
+  const order: StoredOrder = {
+    id: crypto.randomUUID(),
+    lines: lines.map(line => ({ slug: line.slug, qty: line.qty })),
+    ...computeQuote(lines, code),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): StoredOrder | undefined {
+  return orders.get(id)
+}
