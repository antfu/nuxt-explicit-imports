+import type { CartLine } from './cart'
+
+/** Amounts are formatted by the server, e.g. `19.99 USD`. */
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+/** A stored order, as returned by `GET /api/orders/:id`. */
+export interface StoredOrder extends Order {
+  lines: CartLine[]
+}
