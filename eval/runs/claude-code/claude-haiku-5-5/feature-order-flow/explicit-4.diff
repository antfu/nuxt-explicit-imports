+/** A stored order line, with the product name captured when the order was placed. */
+export interface OrderLine {
+  slug: string
+  name: string
+  qty: number
+}
+
+/** Amounts are charged by the server, formatted like the quote API: `19.99 USD`. */
+export interface OrderReceipt {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+export interface Order extends OrderReceipt {
+  lines: OrderLine[]
+}
