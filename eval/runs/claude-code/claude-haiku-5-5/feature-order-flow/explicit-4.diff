+export interface OrderLine {
+  slug: string
+  name: string
+  qty: number
+}
+
+/** Order amounts use the same string format as the quote API, e.g. `19.99 USD`. */
+export interface OrderSummary {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+export interface Order extends OrderSummary {
+  lines: OrderLine[]
+}
