 export function formatMoney(cents: number): string {
   return `$${(cents / 100).toFixed(2)}`
 }
+
+/** Converts a server amount (`19.99 USD`, as returned by the API) to the UI format: `$19.99`. */
+export function formatServerMoney(amount: string): string {
+  return formatMoney(Math.round(Number.parseFloat(amount) * 100))
+}
