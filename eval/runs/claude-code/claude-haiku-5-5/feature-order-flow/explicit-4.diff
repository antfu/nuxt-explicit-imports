+import type { CartLine } from '#shared/types/cart'
+import type { OrderSummary } from '#shared/types/order'
+import { defineEventHandler, readBody, createError } from 'h3'
+import { findProduct } from '#server/utils/db'
+import { createOrder } from '#server/utils/orders'
+
+function isCartLine(line: unknown): line is CartLine {
+  if (typeof line !== 'object' || line === null)
+    return false
+  const { slug, qty } = line as Partial<CartLine>
+  return typeof slug === 'string' && !!findProduct(slug) && Number.isInteger(qty) && qty! > 0
+}
+
+export default defineEventHandler(async (event): Promise<OrderSummary> => {
+  const body = await readBody<{ lines?: unknown, code?: unknown }>(event)
+  if (!Array.isArray(body?.lines) || body.lines.length === 0 || !body.lines.every(isCartLine))
+    throw createError({ statusCode: 400, statusMessage: 'Invalid order lines' })
+  const { id, subtotal, discount, total } = createOrder(
+    body.lines,
+    typeof body.code === 'string' ? body.code : undefined,
+  )
+  return { id, subtotal, discount, total }
+})
