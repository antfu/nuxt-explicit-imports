index 0000000..76fe8e7
--- /dev/null
+++ b/app/pages/deals.vue
@@ -0,0 +1,22 @@
+<script setup lang="ts">
+/** Products priced under $5.00. */
+const DEAL_MAX_CENTS = 500
+
+const { data: products } = await useProducts()
+const { percent } = useDiscount()
+const deals = computed(() => (products.value ?? []).filter(product => product.priceCents < DEAL_MAX_CENTS))
+</script>
+
+<template>
+  <div>
+    <h1>Deals</h1>
+    <section class="product-grid">
+      <ProductCard v-for="product in deals" :key="product.slug" :product="product">
+        <UiBadge>Deal</UiBadge>
+        <p v-if="percent > 0" id="deal-discount">
+          {{ formatPercent(percent) }}
+        </p>
+      </ProductCard>
+    </section>
+  </div>
+</template>
