+import type { CartLine } from '#shared/types/cart'
+import type { Quote } from '#server/utils/quote'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+export interface OrderLine extends CartLine {
+  name: string
+}
+
+export interface Order extends Quote {
+  id: string
+}
+
+export interface StoredOrder extends Order {
+  lines: OrderLine[]
+}
+
+const orders = new Map<string, StoredOrder>()
+let counter = 0
+
+export function createOrder(lines: CartLine[], code?: string): StoredOrder {
+  const id = `ord-${++counter}-${Math.random().toString(36).slice(2, 8)}`
+  const order: StoredOrder = {
+    id,
+    ...computeQuote(lines, code),
+    lines: lines.map(l => ({ ...l, name: findProduct(l.slug)?.name ?? l.slug })),
+  }
+  orders.set(id, order)
+  return order
+}
+
+export function findOrder(id: string): StoredOrder | undefined {
+  return orders.get(id)
+}
