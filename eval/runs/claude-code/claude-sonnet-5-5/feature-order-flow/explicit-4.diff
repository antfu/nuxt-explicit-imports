+<script setup lang="ts">
+import { computed } from 'vue'
+import { useFetch, useRoute } from '#imports'
+import { formatMoney } from '~/utils/money'
+
+interface OrderData {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: { slug: string, qty: number, name: string }[]
+}
+
+const route = useRoute()
+const { data: order } = await useFetch<OrderData>(`/api/orders/${route.params.id}`)
+
+// Server amounts look like `19.99 USD`; show them in the UI money format.
+const total = computed(() =>
+  order.value ? formatMoney(Math.round(Number.parseFloat(order.value.total) * 100)) : '',
+)
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }} × {{ line.qty }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ total }}</span></p>
+  </div>
+</template>
