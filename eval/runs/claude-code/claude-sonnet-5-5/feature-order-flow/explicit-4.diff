+import type { CartLine } from '#shared/types/cart'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+import type { Quote } from '#server/utils/quote'
+
+export interface OrderLine extends CartLine {
+  name: string
+}
+
+export interface Order extends Quote {
+  id: string
+  lines: OrderLine[]
+}
+
+const orders = new Map<string, Order>()
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const id = crypto.randomUUID()
+  const order: Order = {
+    id,
+    ...computeQuote(lines, code),
+    lines: lines.map(l => ({ ...l, name: findProduct(l.slug)?.name ?? l.slug })),
+  }
+  orders.set(id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
