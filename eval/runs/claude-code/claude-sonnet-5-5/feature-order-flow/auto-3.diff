+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,28 @@
+<script setup lang="ts">
+import type { CartLine } from '#shared/types/cart'
+
+interface OrderResponse { id: string, subtotal: string, discount: string, total: string, lines: CartLine[] }
+
+const route = useRoute()
+const { data: products } = await useProducts()
+const { data: order } = await useFetch<OrderResponse>(`/api/orders/${route.params.id}`)
+
+const nameOf = (slug: string) => products.value.find(p => p.slug === slug)?.name ?? slug
+// Server amounts are formatted like "19.99 USD"; re-format them for the UI.
+const total = computed(() => formatMoney(Math.round(Number.parseFloat(order.value?.total ?? '0') * 100)))
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ nameOf(line.slug) }} × {{ line.qty }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ total }}</span></p>
+  </div>
+  <p v-else>
+    Order not found
+  </p>
+</template>
