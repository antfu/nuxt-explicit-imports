+<script setup lang="ts">
+import type { Product } from '#shared/types/product'
+
+const route = useRoute()
+const { data: order } = await useFetch(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+
+function nameOf(slug: string) {
+  return (products.value as Product[]).find(p => p.slug === slug)?.name ?? slug
+}
+
+// The server charges in "19.99 USD" format; show it in the UI format ("$19.99").
+const total = computed(() => formatMoney(Math.round(Number.parseFloat(order.value?.total ?? '0') * 100)))
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ nameOf(line.slug) }} × {{ line.qty }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ total }}</span></p>
+  </div>
+</template>
