@@ -0,0 +1,10 @@
+import type { CartLine } from '#shared/types/cart'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const lines = (body?.lines ?? []).map(l => ({ slug: l.slug, qty: l.qty }))
+  const quote = computeQuote(lines, body?.code)
+  const id = crypto.randomUUID()
+  orders.set(id, { id, lines, ...quote })
+  return { id, ...quote }
+})
