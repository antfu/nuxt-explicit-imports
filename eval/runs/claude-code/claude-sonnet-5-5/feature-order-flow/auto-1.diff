+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ nameOf(line.slug) }} × {{ line.qty }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ formatMoney(order.totalCents) }}</span></p>
+  </div>
+  <p v-else>
+    Order not found
+  </p>
+</template>
