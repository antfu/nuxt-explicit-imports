+import type { CartLine } from '#shared/types/cart'
+
+export interface Order extends Quote {
+  id: string
+  lines: CartLine[]
+  /** Amount charged, in cents (for UI formatting). */
+  totalCents: number
+}
+
+const orders = new Map<string, Order>()
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const cents = computeQuoteCents(lines, code)
+  const order: Order = {
+    id: crypto.randomUUID(),
+    lines: lines.map(l => ({ slug: l.slug, qty: l.qty })),
+    subtotal: formatMoney(cents.subtotal),
+    discount: formatMoney(cents.discount),
+    total: formatMoney(cents.total),
+    totalCents: cents.total,
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
