+<script setup lang="ts">
+import type { CartLine } from '#shared/types/cart'
+import { useFetch, useRoute } from '#app'
+import { computed } from 'vue'
+import { useProducts } from '~/composables/useProducts'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const id = route.params.id
+const { data: products } = await useProducts()
+const { data: order } = await useFetch<{ id: string, total: string }>(`/api/orders/${id}`)
+const { data: lines } = await useFetch<CartLine[]>(`/api/orders/${id}/lines`, { default: () => [] })
+
+// The API formats money as `19.99 USD`; show it in the UI format (`$19.99`).
+const total = computed(() => order.value ? formatMoney(Math.round(Number.parseFloat(order.value.total) * 100)) : '')
+function nameOf(slug: string) {
+  return products.value.find(p => p.slug === slug)?.name ?? slug
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order</h1>
+    <ul>
+      <li v-for="line in lines" :key="line.slug" class="order-line">
+        {{ nameOf(line.slug) }} x{{ line.qty }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ total }}</span></p>
+  </div>
+</template>
