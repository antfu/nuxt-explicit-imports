+<script setup lang="ts">
+import type { CartLine } from '#shared/types/cart'
+import { computed } from 'vue'
+import { useFetch, useRoute } from '#imports'
+import { useProducts } from '~/composables/useProducts'
+import { formatMoney } from '~/utils/money'
+
+interface OrderResponse {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: CartLine[]
+}
+
+const route = useRoute()
+const { data: order } = await useFetch<OrderResponse>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+
+function nameOf(slug: string) {
+  return products.value.find(p => p.slug === slug)?.name ?? slug
+}
+
+// The API returns `19.99 USD`; convert to cents and use the UI money format.
+const total = computed(() => formatMoney(Math.round(Number.parseFloat(order.value?.total ?? '0') * 100)))
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ nameOf(line.slug) }} x{{ line.qty }}
+      </li>
+    </ul>
+    <span id="order-total">{{ total }}</span>
+  </div>
+</template>
