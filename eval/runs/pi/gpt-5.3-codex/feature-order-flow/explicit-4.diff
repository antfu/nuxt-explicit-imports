--- /dev/null
+++ b/server/utils/orders.ts
@@ -0,0 +1,18 @@
+import type { CartLine } from '#shared/types/cart'
+import type { StoredOrder } from '#shared/types/order'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, StoredOrder>()
+let nextOrderId = 1
+
+export function createOrder(lines: CartLine[], code?: string): StoredOrder {
+  const quote = computeQuote(lines, code)
+  const id = String(nextOrderId++)
+  const order: StoredOrder = { id, lines, code, ...quote }
+  orders.set(id, order)
+  return order
+}
+
+export function findOrder(id: string): StoredOrder | undefined {
+  return orders.get(id)
+}
