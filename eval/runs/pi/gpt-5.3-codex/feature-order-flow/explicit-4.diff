diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..c58cabd
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,47 @@
+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { computed } from 'vue'
+import { useFetch, useRoute } from '#imports'
+import { useProducts } from '~/composables/useProducts'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+
+const displayLines = computed(() => {
+  const catalog = products.value ?? []
+  return (order.value?.lines ?? []).map((line) => {
+    const product = catalog.find(item => item.slug === line.slug)
+    return {
+      slug: line.slug,
+      name: product?.name ?? line.slug,
+    }
+  })
+})
+
+const totalCents = computed(() => {
+  const amount = order.value?.total ?? '0.00 USD'
+  const [value] = amount.split(' ')
+  return Math.round(Number(value) * 100)
+})
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li
+        v-for="line in displayLines"
+        :key="line.slug"
+        class="order-line"
+      >
+        {{ line.name }}
+      </li>
+    </ul>
+    <p>
+      Total:
+      <span id="order-total">{{ formatMoney(totalCents) }}</span>
+    </p>
+  </div>
+</template>
diff --git a/server/api/orders.post.ts b/server/api/orders.post.ts
new file mode 100644
index 0000000..77b806b
--- /dev/null
+++ b/server/api/orders.post.ts
@@ -0,0 +1,14 @@
+import type { CartLine } from '#shared/types/cart'
+import { defineEventHandler, readBody } from 'h3'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const order = createOrder(body?.lines ?? [], body?.code)
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+  }
+})
diff --git a/server/api/orders/[id].get.ts b/server/api/orders/[id].get.ts
new file mode 100644
index 0000000..7388131
--- /dev/null
+++ b/server/api/orders/[id].get.ts
@@ -0,0 +1,10 @@
+import { createError, defineEventHandler, getRouterParam } from 'h3'
+import { findOrder } from '#server/utils/orders'
+
+export default defineEventHandler((event) => {
+  const id = getRouterParam(event, 'id') ?? ''
+  const order = findOrder(id)
+  if (!order)
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  return order
+})
diff --git a/server/utils/orders.ts b/server/utils/orders.ts
new file mode 100644
index 0000000..1147a60
--- /dev/null
+++ b/server/utils/orders.ts
@@ -0,0 +1,18 @@
+import { randomUUID } from 'node:crypto'
+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, Order>()
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const id = randomUUID()
+  const quote = computeQuote(lines, code)
+  const order: Order = { id, lines, code, ...quote }
+  orders.set(id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
