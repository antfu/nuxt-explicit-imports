+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,38 @@
+<script setup lang="ts">
+import type { OrderSummary } from '#shared/types/order'
+import type { Product } from '#shared/types/product'
+
+const route = useRoute()
+const { data: order } = await useFetch<OrderSummary>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+const { lines } = useCart()
+
+const orderTotal = computed(() => {
+  const amount = Number.parseFloat(order.value?.total ?? '')
+  if (!Number.isFinite(amount))
+    return ''
+  return formatMoney(Math.round(amount * 100))
+})
+
+function productName(slug: string) {
+  return products.value?.find((product: Product) => product.slug === slug)?.name ?? slug
+}
+</script>
+
+<template>
+  <div>
+    <h1>Order {{ order?.id }}</h1>
+    <ul>
+      <li
+        v-for="line in lines"
+        :key="line.slug"
+        class="order-line"
+      >
+        {{ productName(line.slug) }}
+      </li>
+    </ul>
+    <p>
+      Total: <span id="order-total">{{ orderTotal }}</span>
+    </p>
+  </div>
+</template>
