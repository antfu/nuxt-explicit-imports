+import type { CartLine } from '#shared/types/cart'
+import type { OrderSummary } from '#shared/types/order'
+
+interface StoredOrder extends OrderSummary {
+  lines: CartLine[]
+  code?: string
+}
+
+const orders = new Map<string, StoredOrder>()
+let nextOrderId = 1
+
+export function createOrder(lines: CartLine[], code?: string): OrderSummary {
+  const id = String(nextOrderId++)
+  const quote = computeQuote(lines, code)
+  const order: StoredOrder = {
+    id,
+    lines: lines.map(line => ({ ...line })),
+    code,
+    ...quote,
+  }
+  orders.set(id, order)
+  return { id, subtotal: quote.subtotal, discount: quote.discount, total: quote.total }
+}
+
+export function findOrder(id: string): OrderSummary | undefined {
+  const order = orders.get(id)
+  if (!order)
+    return
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+  }
+}
