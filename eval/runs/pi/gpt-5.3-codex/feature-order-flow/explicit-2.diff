diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..86c7ad2
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,35 @@
+<script setup lang="ts">
+import type { Product } from '#shared/types/product'
+import type { Order } from '#shared/types/order'
+import { useRoute, useFetch } from '#app'
+import { computed } from 'vue'
+import { useProducts } from '~/composables/useProducts'
+
+const route = useRoute()
+const id = computed(() => String(route.params.id ?? ''))
+
+const { data: order } = await useFetch<Order>(() => `/api/orders/${id.value}`)
+const { data: products } = await useProducts()
+
+const orderLines = computed(() => (order.value?.lines ?? []).map((line) => {
+  const product = products.value?.find((p: Product) => p.slug === line.slug)
+  return {
+    ...line,
+    name: product?.name ?? line.slug,
+  }
+}))
+</script>
+
+<template>
+  <div>
+    <h1>Order {{ order?.id }}</h1>
+    <ul>
+      <li v-for="line in orderLines" :key="line.slug" class="order-line">
+        {{ line.name }}
+      </li>
+    </ul>
+    <p>
+      Total: <span id="order-total">{{ order?.total }}</span>
+    </p>
+  </div>
+</template>
