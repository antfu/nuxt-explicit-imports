+<script setup lang="ts">
+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+import type { Product } from '#shared/types/product'
+
+const route = useRoute()
+const { data: products } = await useProducts()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+const total = computed(() => formatMoney(parseApiMoney(order.value?.total ?? '0.00 USD')))
+
+function productName(line: CartLine): string {
+  const product = products.value?.find((item: Product) => item.slug === line.slug)
+  return product?.name ?? line.slug
+}
+</script>
+
+<template>
+  <div>
+    <h1>Order {{ order?.id }}</h1>
+
+    <ul v-if="order">
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ productName(line) }}
+      </li>
+    </ul>
+
+    <p v-if="order">
+      Total: <span id="order-total">{{ total }}</span>
+    </p>
+  </div>
+</template>
