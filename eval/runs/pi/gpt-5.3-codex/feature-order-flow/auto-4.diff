+import type { CartLine } from '#shared/types/cart'
+import type { OrderQuote } from '#shared/types/order'
+
+export default defineEventHandler(async (event): Promise<OrderQuote> => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const order = createOrder(body?.lines ?? [], body?.code)
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+  }
+})
