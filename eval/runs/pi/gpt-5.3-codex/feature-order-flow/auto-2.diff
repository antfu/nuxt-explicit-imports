diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..99521e6
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,30 @@
+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+
+const lineNames = computed(() => order.value?.lines.map((line) => {
+  return products.value.find(product => product.slug === line.slug)?.name ?? line.slug
+}) ?? [])
+
+const orderTotal = computed(() => {
+  const cents = Math.round(Number.parseFloat(order.value?.total ?? '0') * 100)
+  return formatMoney(Number.isFinite(cents) ? cents : 0)
+})
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="(name, index) in lineNames" :key="`${name}-${index}`" class="order-line">
+        {{ name }}
+      </li>
+    </ul>
+    <p>
+      Total: <span id="order-total">{{ orderTotal }}</span>
+    </p>
+  </div>
+</template>
