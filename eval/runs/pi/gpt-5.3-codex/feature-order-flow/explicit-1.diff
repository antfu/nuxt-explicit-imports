--- /dev/null
+++ b/server/utils/orders.ts
@@ -0,0 +1,23 @@
+import { randomUUID } from 'node:crypto'
+import type { CartLine } from '#shared/types/cart'
+import type { OrderCharge, StoredOrder } from '#shared/types/order'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, StoredOrder>()
+
+export function createOrder(lines: CartLine[], code?: string): OrderCharge {
+  const id = randomUUID()
+  const quote = computeQuote(lines, code)
+  const order: StoredOrder = {
+    id,
+    lines: lines.map(line => ({ ...line })),
+    ...(code ? { code } : {}),
+    ...quote,
+  }
+  orders.set(id, order)
+  return { id, ...quote }
+}
+
+export function findOrder(id: string): StoredOrder | undefined {
+  return orders.get(id)
+}
