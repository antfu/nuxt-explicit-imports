diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..f8f8fbd
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,36 @@
+<script setup lang="ts">
+import type { StoredOrder } from '#shared/types/order'
+import { computed } from 'vue'
+import { useRoute, useFetch } from '#app'
+import { useProducts } from '~/composables/useProducts'
+
+const route = useRoute()
+const id = computed(() => route.params.id as string)
+
+const { data: products } = await useProducts()
+const { data: order } = await useFetch<StoredOrder>(() => `/api/orders/${id.value}`)
+
+const orderLines = computed(() => (order.value?.lines ?? []).map((line) => {
+  const product = products.value.find(p => p.slug === line.slug)
+  return product?.name ?? line.slug
+}))
+
+const orderTotal = computed(() => {
+  const total = order.value?.total
+  if (!total)
+    return ''
+  return `$${Number.parseFloat(total).toFixed(2)}`
+})
+</script>
+
+<template>
+  <div>
+    <h1>Order</h1>
+    <ul>
+      <li v-for="(name, index) in orderLines" :key="index" class="order-line">
+        {{ name }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ orderTotal }}</span></p>
+  </div>
+</template>
