diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..c127726
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,42 @@
+<script setup lang="ts">
+import type { Product } from '#shared/types/product'
+import type { Order } from '#shared/types/order'
+import { computed } from 'vue'
+import { createError, useFetch, useRoute } from '#imports'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const orderId = computed(() => String(route.params.id ?? ''))
+
+const { data: order } = await useFetch<Order>(() => `/api/orders/${orderId.value}?includeLines=1`)
+if (!order.value) {
+  throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+}
+
+const { data: products } = await useFetch<Product[]>('/api/products', {
+  key: 'products',
+  default: () => [],
+})
+
+const productNameBySlug = computed(() => Object.fromEntries(products.value.map(product => [product.slug, product.name])))
+const orderTotal = computed(() => {
+  const amount = Number.parseFloat(order.value?.total ?? '0')
+  return formatMoney(Number.isFinite(amount) ? Math.round(amount * 100) : 0)
+})
+</script>
+
+<template>
+  <div>
+    <h1>Order {{ order?.id }}</h1>
+    <ul>
+      <li
+        v-for="line in order?.lines ?? []"
+        :key="line.slug"
+        class="order-line"
+      >
+        {{ productNameBySlug[line.slug] ?? line.slug }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ orderTotal }}</span></p>
+  </div>
+</template>
diff --git a/server/api/orders.post.ts b/server/api/orders.post.ts
new file mode 100644
index 0000000..25388bf
--- /dev/null
+++ b/server/api/orders.post.ts
@@ -0,0 +1,15 @@
+import type { CartLine } from '#shared/types/cart'
+import type { OrderSummary } from '#shared/types/order'
+import { defineEventHandler, readBody } from 'h3'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event): Promise<OrderSummary> => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const order = createOrder(body?.lines ?? [], body?.code)
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+  }
+})
diff --git a/server/api/orders/[id].get.ts b/server/api/orders/[id].get.ts
new file mode 100644
index 0000000..51dfee2
--- /dev/null
+++ b/server/api/orders/[id].get.ts
@@ -0,0 +1,27 @@
+import type { OrderSummary } from '#shared/types/order'
+import { createError, defineEventHandler, getQuery, getRouterParam } from 'h3'
+import { getOrder } from '#server/utils/orders'
+
+export default defineEventHandler((event): OrderSummary => {
+  const id = getRouterParam(event, 'id')
+  if (!id) {
+    throw createError({ statusCode: 400, statusMessage: 'Order id is required' })
+  }
+
+  const order = getOrder(id)
+  if (!order) {
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  }
+
+  const { includeLines } = getQuery(event)
+  if (includeLines) {
+    return order
+  }
+
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+  }
+})
diff --git a/server/utils/orders.ts b/server/utils/orders.ts
new file mode 100644
index 0000000..c4976fd
--- /dev/null
+++ b/server/utils/orders.ts
@@ -0,0 +1,23 @@
+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, Order>()
+let nextOrderId = 1
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const id = String(nextOrderId++)
+  const quote = computeQuote(lines, code)
+  const order: Order = {
+    id,
+    lines: lines.map(line => ({ ...line })),
+    code,
+    ...quote,
+  }
+  orders.set(id, order)
+  return order
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
