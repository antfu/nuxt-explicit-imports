+import type { CartLine } from '#shared/types/cart'
+import type { Quote } from './quote'
+
+export interface OrderSummary extends Quote {
+  id: string
+}
+
+export interface StoredOrder extends OrderSummary {
+  lines: CartLine[]
+  code?: string
+}
+
+const orders = new Map<string, StoredOrder>()
+
+export function createOrder(lines: CartLine[], code?: string): OrderSummary {
+  const id = crypto.randomUUID()
+  const quote = computeQuote(lines, code)
+  const order: StoredOrder = {
+    id,
+    lines: lines.map(line => ({ ...line })),
+    code,
+    ...quote,
+  }
+  orders.set(id, order)
+  return {
+    id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+  }
+}
+
+export function getOrder(id: string): StoredOrder | undefined {
+  return orders.get(id)
+}
