+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,33 @@
+<script setup lang="ts">
+import type { Product } from '#shared/types/product'
+
+const route = useRoute()
+const { lines } = useCart()
+
+await useProducts()
+const { data: products } = useNuxtData<Product[]>('products')
+const { data: order } = await useFetch<{ total: string }>(`/api/orders/${route.params.id}`)
+
+function toUiMoney(serverMoney: string): string {
+  const dollars = Number.parseFloat(serverMoney)
+  if (!Number.isFinite(dollars))
+    return serverMoney
+  return formatMoney(Math.round(dollars * 100))
+}
+
+function productName(slug: string): string {
+  return products.value?.find(product => product.slug === slug)?.name ?? slug
+}
+</script>
+
+<template>
+  <div>
+    <h1>Order</h1>
+    <ul>
+      <li v-for="line in lines" :key="line.slug" class="order-line">
+        {{ productName(line.slug) }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ order ? toUiMoney(order.total) : '' }}</span></p>
+  </div>
+</template>
