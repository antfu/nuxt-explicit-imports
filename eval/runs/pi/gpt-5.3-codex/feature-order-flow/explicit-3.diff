+import type { CartLine } from './cart'
+
+export interface Order {
+  id: string
+  lines: CartLine[]
+  code?: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+export interface CreateOrderBody {
+  lines?: CartLine[]
+  code?: string
+}
+
+export type CreateOrderResponse = Pick<Order, 'id' | 'subtotal' | 'discount' | 'total'>
