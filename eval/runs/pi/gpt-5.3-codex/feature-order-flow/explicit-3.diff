@@ -0,0 +1,25 @@
+import type { CartLine } from '#shared/types/cart'
+import type { CreateOrderResponse, Order } from '#shared/types/order'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, Order>()
+let nextOrderId = 1
+
+export function createOrder(lines: CartLine[], code?: string): CreateOrderResponse {
+  const id = String(nextOrderId++)
+  const { subtotal, discount, total } = computeQuote(lines, code)
+  const order: Order = {
+    id,
+    lines: lines.map(line => ({ ...line })),
+    code,
+    subtotal,
+    discount,
+    total,
+  }
+  orders.set(id, order)
+  return { id, subtotal, discount, total }
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
