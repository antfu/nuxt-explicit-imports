--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,41 @@
+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import type { Product } from '#shared/types/product'
+import { computed } from 'vue'
+import { createError, useFetch, useRoute } from '#imports'
+import { formatMoney } from '~/utils/money'
+import { useProducts } from '~/composables/useProducts'
+
+const route = useRoute()
+const { data: products } = await useProducts()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+if (!order.value)
+  throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+
+const orderData = computed(() => order.value as Order)
+const total = computed(() => formatMoney(parseUsdMoney(orderData.value.total)))
+
+function parseUsdMoney(value: string): number {
+  const amount = Number.parseFloat(value)
+  return Number.isFinite(amount) ? Math.round(amount * 100) : 0
+}
+
+function productName(slug: string): string {
+  return products.value?.find((product: Product) => product.slug === slug)?.name ?? slug
+}
+</script>
+
+<template>
+  <div>
+    <h1>Order {{ orderData.id }}</h1>
+    <ul>
+      <li v-for="line in orderData.lines" :key="line.slug" class="order-line">
+        {{ productName(line.slug) }}
+      </li>
+    </ul>
+    <p>
+      Total: <span id="order-total">{{ total }}</span>
+    </p>
+  </div>
+</template>
diff --git a/server/api/orders.post.ts b/server/api/orders.post.ts
new file mode 100644
index 0000000..c80ad47
--- /dev/null
+++ b/server/api/orders.post.ts
@@ -0,0 +1,15 @@
+import type { CartLine } from '#shared/types/cart'
+import type { OrderReceipt } from '#shared/types/order'
+import { defineEventHandler, readBody } from 'h3'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event): Promise<OrderReceipt> => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const order = createOrder(body?.lines ?? [], body?.code)
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+  }
+})
