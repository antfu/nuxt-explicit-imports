+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,32 @@
+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { useFetch, useRoute } from '#app'
+import { computed } from 'vue'
+import { useProducts } from '~/composables/useProducts'
+
+const route = useRoute()
+const { data: order, error } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+if (error.value)
+  throw error.value
+
+const { data: products } = await useProducts()
+const orderLines = computed(() => order.value?.lines ?? [])
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li
+        v-for="line in orderLines"
+        :key="line.slug"
+        class="order-line"
+      >
+        {{ products.find(p => p.slug === line.slug)?.name ?? line.slug }}
+      </li>
+    </ul>
+    <p>
+      Total: <span id="order-total">{{ order.total }}</span>
+    </p>
+  </div>
+</template>
