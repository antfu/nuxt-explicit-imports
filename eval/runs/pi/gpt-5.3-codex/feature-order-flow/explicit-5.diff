diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..a9bacb0
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,41 @@
+<script setup lang="ts">
+import type { OrderTotals } from '#shared/types/order'
+import { useRoute, useFetch } from '#app'
+import { computed } from 'vue'
+import { useProducts } from '~/composables/useProducts'
+import { useCart } from '~/composables/useCart'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order } = await useFetch<OrderTotals>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+const { lines } = useCart()
+
+const lineNames = computed(() => lines.value.map((line) => {
+  const product = products.value.find(product => product.slug === line.slug)
+  return product?.name ?? line.slug
+}))
+
+const totalCents = computed(() => {
+  const rawTotal = order.value?.total
+  if (!rawTotal)
+    return 0
+
+  const amount = Number.parseFloat(rawTotal.replace(' USD', ''))
+  return Number.isNaN(amount) ? 0 : Math.round(amount * 100)
+})
+</script>
+
+<template>
+  <div>
+    <h1>Order {{ order?.id }}</h1>
+    <ul>
+      <li v-for="name in lineNames" :key="name" class="order-line">
+        {{ name }}
+      </li>
+    </ul>
+    <p>
+      Total: <span id="order-total">{{ formatMoney(totalCents) }}</span>
+    </p>
+  </div>
+</template>
