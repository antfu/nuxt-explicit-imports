diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..755f495
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,41 @@
+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { computed } from 'vue'
+import { useFetch, useRoute } from '#imports'
+import { useProducts } from '~/composables/useProducts'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+
+const orderTotal = computed(() => formatMoney(parseServerMoney(order.value?.total ?? '0.00 USD')))
+
+function parseServerMoney(amount: string): number {
+  const [raw] = amount.split(' ')
+  return Math.round(Number(raw) * 100)
+}
+
+function productName(slug: string): string {
+  return products.value?.find(product => product.slug === slug)?.name ?? slug
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li
+        v-for="line in order.lines"
+        :key="line.slug"
+        class="order-line"
+      >
+        {{ productName(line.slug) }}
+      </li>
+    </ul>
+    <p>
+      Total:
+      <span id="order-total">{{ orderTotal }}</span>
+    </p>
+  </div>
+</template>
