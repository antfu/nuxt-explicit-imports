+++ b/server/api/orders.post.ts
@@ -0,0 +1,11 @@
+import type { OrderRequest } from '#shared/types/order'
+import { defineEventHandler, readBody } from 'h3'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<Partial<OrderRequest>>(event)
+  return createOrder({
+    lines: body?.lines ?? [],
+    code: body?.code,
+  })
+})
diff --git a/server/api/orders/[id].get.ts b/server/api/orders/[id].get.ts
new file mode 100644
index 0000000..bb28896
--- /dev/null
+++ b/server/api/orders/[id].get.ts
@@ -0,0 +1,16 @@
+import { createError, defineEventHandler } from 'h3'
+import { getOrder } from '#server/utils/orders'
+
+export default defineEventHandler((event) => {
+  const id = event.context.params?.id
+  if (!id) {
+    throw createError({ statusCode: 400, statusMessage: 'Order id is required' })
+  }
+
+  const order = getOrder(id)
+  if (!order) {
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  }
+
+  return order
+})
diff --git a/server/utils/orders.ts b/server/utils/orders.ts
new file mode 100644
index 0000000..64044a3
--- /dev/null
+++ b/server/utils/orders.ts
@@ -0,0 +1,33 @@
+import type { OrderRequest, OrderTotals, StoredOrder } from '#shared/types/order'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, StoredOrder>()
+let nextOrderId = 1
+
+export function createOrder(payload: OrderRequest): OrderTotals {
+  const id = String(nextOrderId++)
+  const quote = computeQuote(payload.lines, payload.code)
+  orders.set(id, {
+    id,
+    lines: payload.lines,
+    code: payload.code,
+    ...quote,
+  })
+  return {
+    id,
+    ...quote,
+  }
+}
+
+export function getOrder(id: string): OrderTotals | undefined {
+  const order = orders.get(id)
+  if (!order)
+    return undefined
+
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+  }
+}
