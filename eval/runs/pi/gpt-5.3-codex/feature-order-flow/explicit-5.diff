--- /dev/null
+++ b/server/api/orders/[id].get.ts
@@ -0,0 +1,10 @@
+import { createError, defineEventHandler, getRouterParam } from 'h3'
+import { getOrder } from '#server/utils/orders'
+
+export default defineEventHandler((event) => {
+  const id = getRouterParam(event, 'id') ?? ''
+  const order = getOrder(id)
+  if (!order)
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  return order
+})
diff --git a/server/utils/orders.ts b/server/utils/orders.ts
new file mode 100644
index 0000000..1bbcbfa
--- /dev/null
+++ b/server/utils/orders.ts
@@ -0,0 +1,38 @@
+import type { Order, OrderInput, OrderSummary } from '#shared/types/order'
+import { computeQuote } from '#server/utils/quote'
+
+const orders = new Map<string, Order>()
+let nextOrderId = 1
+
+function generateOrderId(): string {
+  const id = `${nextOrderId}`
+  nextOrderId += 1
+  return id
+}
+
+function cloneLines(input: OrderInput['lines']): OrderInput['lines'] {
+  return input.map(line => ({ ...line }))
+}
+
+export function createOrder(input: OrderInput): OrderSummary {
+  const id = generateOrderId()
+  const quote = computeQuote(input.lines, input.code)
+  const order: Order = {
+    id,
+    lines: cloneLines(input.lines),
+    code: input.code,
+    ...quote,
+  }
+  orders.set(id, order)
+  return { id, ...quote }
+}
+
+export function getOrder(id: string): Order | undefined {
+  const order = orders.get(id)
+  if (!order)
+    return undefined
+  return {
+    ...order,
+    lines: cloneLines(order.lines),
+  }
+}
