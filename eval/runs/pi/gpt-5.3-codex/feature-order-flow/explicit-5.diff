@@ -0,0 +1,11 @@
+import type { OrderInput } from '#shared/types/order'
+import { defineEventHandler, readBody } from 'h3'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<Partial<OrderInput>>(event)
+  return createOrder({
+    lines: body?.lines ?? [],
+    code: body?.code,
+  })
+})
