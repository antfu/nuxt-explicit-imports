+import type { CartLine } from '#shared/types/cart'
+
+export interface OrderRequest {
+  lines: CartLine[]
+  code?: string
+}
+
+export interface OrderTotals {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+export interface StoredOrder extends OrderTotals {
+  lines: CartLine[]
+  code?: string
+}
