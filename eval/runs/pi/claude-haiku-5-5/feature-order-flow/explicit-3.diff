+/** A line of a placed order. The name is captured when the order is placed. */
+export interface OrderLine {
+  slug: string
+  name: string
+  qty: number
+}
+
+/** Amounts are formatted by the server, like the quote API: `19.99 USD`. */
+export interface OrderTotals {
+  subtotal: string
+  discount: string
+  total: string
+}
+
+export interface OrderSummary extends OrderTotals {
+  id: string
+}
+
+export interface Order extends OrderSummary {
+  lines: OrderLine[]
+}
