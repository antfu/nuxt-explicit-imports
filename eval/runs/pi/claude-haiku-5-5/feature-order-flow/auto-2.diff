+import type { CartLine } from './cart'
+
+/** An order as returned by `POST /api/orders` and `GET /api/orders/:id`. Amounts are server-formatted, like the quote API. */
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+/** `GET /api/orders/:id` also includes the lines the order was placed with. */
+export interface StoredOrder extends Order {
+  lines: CartLine[]
+}
