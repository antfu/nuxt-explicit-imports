+<script setup lang="ts">
+import type { StoredOrder } from '#shared/types/order'
+
+const route = useRoute()
+const { data: products } = await useProducts()
+const { data: order } = await useFetch<StoredOrder>(`/api/orders/${route.params.id}`, { key: `order-${route.params.id}` })
+if (!order.value)
+  throw createError({ statusCode: 404, statusMessage: 'Order not found', fatal: true })
+
+/** The API sends money as `19.99 USD`; the UI shows `$19.99`. */
+const totalCents = computed(() => Math.round(Number.parseFloat(order.value?.total ?? '0') * 100))
+
+function nameOf(slug: string) {
+  return products.value.find(p => p.slug === slug)?.name ?? slug
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        <span class="name">{{ nameOf(line.slug) }}</span>
+        <span class="qty">x{{ line.qty }}</span>
+      </li>
+    </ul>
+    <p>Subtotal: <span id="order-subtotal">{{ order.subtotal }}</span></p>
+    <p>Discount: <span id="order-discount">{{ order.discount }}</span></p>
+    <p>Total: <span id="order-total">{{ formatMoney(totalCents) }}</span></p>
+  </div>
+</template>
