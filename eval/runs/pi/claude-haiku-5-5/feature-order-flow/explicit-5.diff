+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderLine } from '#shared/types/order'
+import { randomUUID } from 'node:crypto'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+/** In-memory order storage. Orders are lost on restart. */
+const orders = new Map<string, Order>()
+
+/** Resolves and validates cart lines. Throws a message string when a line is invalid. */
+export function resolveLines(input: unknown): OrderLine[] {
+  if (!Array.isArray(input))
+    throw new Error('lines must be an array')
+  return input.map((raw) => {
+    const { slug, qty } = (raw ?? {}) as Partial<CartLine>
+    const product = typeof slug === 'string' ? findProduct(slug) : undefined
+    if (!product)
+      throw new Error(`Unknown product: ${String(slug)}`)
+    if (!Number.isInteger(qty) || qty! < 1)
+      throw new Error(`Invalid qty for ${product.slug}`)
+    return { slug: product.slug, name: product.name, qty: qty! }
+  })
+}
+
+/** Stores an order priced by the server, using the same calculation as the quote API. */
+export function createOrder(lines: OrderLine[], code?: string): Order {
+  const quote = computeQuote(lines, code)
+  const order: Order = { id: randomUUID(), lines, ...quote }
+  orders.set(order.id, order)
+  return order
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
