+import type { CartLine } from '#shared/types/cart'
+import type { OrderCreated, OrderView } from '#shared/types/order'
+
+interface StoredOrder {
+  id: string
+  lines: CartLine[]
+  names: string[]
+  subtotal: number
+  discount: number
+  total: number
+}
+
+/** In-memory order store. Orders are lost when the server restarts. */
+const orders = new Map<string, StoredOrder>()
+
+/** Validates the lines, prices them on the server and stores the order. Throws 400 on invalid input. */
+export function createOrder(lines: CartLine[], code?: string): OrderCreated {
+  if (!Array.isArray(lines) || lines.length === 0) {
+    throw createError({ statusCode: 400, statusMessage: 'Order needs at least one line' })
+  }
+  const names = lines.map((line) => {
+    const product = findProduct(line.slug)
+    if (!product) {
+      throw createError({ statusCode: 400, statusMessage: `Unknown product: ${line.slug}` })
+    }
+    if (!Number.isInteger(line.qty) || line.qty < 1) {
+      throw createError({ statusCode: 400, statusMessage: `Invalid quantity for ${line.slug}` })
+    }
+    return product.name
+  })
+  const priced = priceCart(lines, code)
+  const order: StoredOrder = {
+    id: crypto.randomUUID(),
+    lines: lines.map(line => ({ slug: line.slug, qty: line.qty })),
+    names,
+    ...priced,
+  }
+  orders.set(order.id, order)
+  return toCreated(order)
+}
+
+export function getOrder(id: string): OrderView | undefined {
+  const order = orders.get(id)
+  if (!order)
+    return undefined
+  return {
+    ...toCreated(order),
+    lines: order.lines.map((line, i) => ({ slug: line.slug, name: order.names[i]!, qty: line.qty })),
+  }
+}
+
+function toCreated(order: StoredOrder): OrderCreated {
+  return {
+    id: order.id,
+    subtotal: formatMoney(order.subtotal),
+    discount: formatMoney(order.discount),
+    total: formatMoney(order.total),
+  }
+}
