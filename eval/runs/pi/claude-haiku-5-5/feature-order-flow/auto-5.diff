+<script setup lang="ts">
+import type { OrderView } from '#shared/types/order'
+
+const route = useRoute()
+const { data: order, error } = await useFetch<OrderView>(`/api/orders/${route.params.id}`)
+if (error.value || !order.value)
+  throw createError({ statusCode: 404, statusMessage: 'Order not found', fatal: true })
+const total = computed(() => parseMoney(order.value!.total))
+const discount = computed(() => parseMoney(order.value!.discount))
