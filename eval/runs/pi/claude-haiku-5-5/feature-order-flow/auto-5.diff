@@ -0,0 +1,26 @@
+import type { CartLine } from './cart'
+
+/** Request body for `POST /api/orders`. Same shape as the cart quote request. */
+export interface OrderRequest {
+  lines: CartLine[]
+  code?: string
+}
+
+/** Response of `POST /api/orders`. Amounts are formatted by the server, like the quote API. */
+export interface OrderCreated {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+export interface OrderLineView {
+  slug: string
+  name: string
+  qty: number
+}
+
+/** Response of `GET /api/orders/:id`. */
+export interface OrderView extends OrderCreated {
+  lines: OrderLineView[]
+}
