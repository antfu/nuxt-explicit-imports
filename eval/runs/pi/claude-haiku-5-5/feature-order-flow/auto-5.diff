+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }} × {{ line.qty }}
+      </li>
+    </ul>
+    <p v-if="discount">
+      Discount: {{ formatDiscount(discount) }}
+    </p>
+    <p>Total: <span id="order-total">{{ formatMoney(total) }}</span></p>
+  </div>
+</template>
