+import type { OrderSummary } from '#shared/types/order'
+import { defineEventHandler, readBody } from 'h3'
+import { parseOrderBody, placeOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event): Promise<OrderSummary> => {
+  const { lines, code } = parseOrderBody(await readBody(event))
+  return placeOrder(lines, code)
+})
