+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderLine, OrderSummary } from '#shared/types/order'
+import { randomUUID } from 'node:crypto'
+import { createError } from 'h3'
+import { findProduct } from '#server/utils/db'
+import { formatMoney } from '#server/utils/money'
+import { priceLines } from '#server/utils/quote'
+
+interface StoredOrder {
+  id: string
+  lines: OrderLine[]
+  subtotal: number
+  discount: number
+  total: number
+}
+
+/** Orders live in server memory only; they are lost on restart. */
+const orders = new Map<string, StoredOrder>()
+
+/** Validates the request body and narrows it to cart lines and an optional code. */
+export function parseOrderBody(body: unknown): { lines: CartLine[], code?: string } {
+  const input = (body ?? {}) as { lines?: unknown, code?: unknown }
+  if (!Array.isArray(input.lines) || input.lines.length === 0)
+    throw createError({ statusCode: 400, statusMessage: 'lines must be a non-empty array' })
+  if (input.code !== undefined && input.code !== null && typeof input.code !== 'string')
+    throw createError({ statusCode: 400, statusMessage: 'code must be a string' })
+
+  const lines = input.lines.map((line: unknown) => {
+    const { slug, qty } = (line ?? {}) as { slug?: unknown, qty?: unknown }
+    if (typeof slug !== 'string' || !findProduct(slug))
+      throw createError({ statusCode: 400, statusMessage: `Unknown product: ${String(slug)}` })
+    if (typeof qty !== 'number' || !Number.isInteger(qty) || qty < 1)
+      throw createError({ statusCode: 400, statusMessage: 'qty must be a positive integer' })
+    return { slug, qty }
+  })
+  return { lines, code: typeof input.code === 'string' ? input.code : undefined }
+}
+
+export function placeOrder(lines: CartLine[], code?: string): OrderSummary {
+  const priced = priceLines(lines, code)
+  const stored: StoredOrder = {
+    id: randomUUID(),
+    lines: lines.map(line => ({ slug: line.slug, name: findProduct(line.slug)?.name ?? line.slug, qty: line.qty })),
+    subtotal: priced.subtotal,
+    discount: priced.discount,
+    total: priced.total,
+  }
+  orders.set(stored.id, stored)
+  return toSummary(stored)
+}
+
+export function getOrder(id: string): Order | undefined {
+  const stored = orders.get(id)
+  return stored && { ...toSummary(stored), lines: stored.lines }
+}
+
+function toSummary(order: StoredOrder): OrderSummary {
+  return {
+    id: order.id,
+    subtotal: formatMoney(order.subtotal),
+    discount: formatMoney(order.discount),
+    total: formatMoney(order.total),
+  }
+}
