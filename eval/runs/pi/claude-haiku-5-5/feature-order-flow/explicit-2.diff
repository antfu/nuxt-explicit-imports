@@ -0,0 +1,18 @@
+export interface OrderLine {
+  slug: string
+  name: string
+  qty: number
+}
+
+/** Response of `POST /api/orders`. Amounts use the server money format, like the quote API. */
+export interface OrderSummary {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+/** Response of `GET /api/orders/:id`. */
+export interface Order extends OrderSummary {
+  lines: OrderLine[]
+}
