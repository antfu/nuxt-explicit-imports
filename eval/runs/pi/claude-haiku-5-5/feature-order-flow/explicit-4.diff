+import type { CartLine } from '#shared/types/cart'
+import { createError, defineEventHandler, readBody } from 'h3'
+import { createOrder, resolveLines } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const lines = body?.lines
+  if (!Array.isArray(lines) || !lines.every(line => Number.isInteger(line?.qty) && line.qty > 0))
+    throw createError({ statusCode: 400, statusMessage: 'Invalid lines' })
+  const resolved = resolveLines(lines)
+  if (!resolved)
+    throw createError({ statusCode: 400, statusMessage: 'Unknown product' })
+  const { id, subtotal, discount, total } = createOrder(resolved, body?.code)
+  return { id, subtotal, discount, total }
+})
