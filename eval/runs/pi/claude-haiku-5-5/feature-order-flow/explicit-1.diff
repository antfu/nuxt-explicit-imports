+import type { CartLine } from '#shared/types/cart'
+import type { Order } from '#shared/types/order'
+import { randomUUID } from 'node:crypto'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+/** In-memory order store. Lost on restart. */
+const orders = new Map<string, Order>()
+
+/** Validates untrusted request lines. Returns undefined when the input is not a non-empty list of known products with positive integer qty. */
+export function parseOrderLines(value: unknown): CartLine[] | undefined {
+  if (!Array.isArray(value) || value.length === 0)
+    return undefined
+  const lines: CartLine[] = []
+  for (const item of value) {
+    const { slug, qty } = (item ?? {}) as Partial<CartLine>
+    if (typeof slug !== 'string' || !findProduct(slug) || typeof qty !== 'number' || !Number.isInteger(qty) || qty < 1)
+      return undefined
+    lines.push({ slug, qty })
+  }
+  return lines
+}
+
+/** Prices the lines with the same rules as the quote API and stores the order. */
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const quote = computeQuote(lines, code)
+  const order: Order = {
+    id: randomUUID(),
+    ...quote,
+    lines: lines.map(line => ({ slug: line.slug, qty: line.qty, name: findProduct(line.slug)?.name ?? line.slug })),
+  }
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
