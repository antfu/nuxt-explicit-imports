+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { useFetch, useRoute } from '#imports'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+/** `19.99 USD` (server format) -> `1999` cents, so the UI can use its own money format. */
+function toCents(text: string): number {
+  return Math.round(Number.parseFloat(text) * 100)
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }} × {{ line.qty }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ formatMoney(toCents(order.total)) }}</span></p>
+  </div>
+</template>
