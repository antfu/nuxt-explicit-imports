+import type { CartLine } from '#shared/types/cart'
+
+/** Server-charged amounts, formatted like the quote API: `19.99 USD`. */
+export interface OrderReceipt {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+export interface OrderLine extends CartLine {
+  name: string
+}
+
+/** A stored order as returned by `GET /api/orders/:id`. */
+export interface Order extends OrderReceipt {
+  lines: OrderLine[]
+}
