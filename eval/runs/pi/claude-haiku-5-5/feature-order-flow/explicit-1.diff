+import type { OrderReceipt } from '#shared/types/order'
+import { createError, defineEventHandler, readBody } from 'h3'
+import { createOrder, parseOrderLines } from '#server/utils/orders'
+
+export default defineEventHandler(async (event): Promise<OrderReceipt> => {
+  const body = await readBody<{ lines?: unknown, code?: unknown }>(event)
+  const lines = parseOrderLines(body?.lines)
+  if (!lines)
+    throw createError({ statusCode: 400, statusMessage: 'Invalid order lines' })
+  const { id, subtotal, discount, total } = createOrder(lines, typeof body.code === 'string' ? body.code : undefined)
+  return { id, subtotal, discount, total }
+})
