@@ -0,0 +1,19 @@
+import type { CartLine } from './cart'
+
+/** Response of `POST /api/orders`, amounts formatted like the quote API (`19.99 USD`). */
+export interface OrderSummary {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+}
+
+/** A line as stored on the order, with the product name captured at order time. */
+export interface OrderLine extends CartLine {
+  name: string
+}
+
+/** Response of `GET /api/orders/:id`. */
+export interface Order extends OrderSummary {
+  lines: OrderLine[]
+}
