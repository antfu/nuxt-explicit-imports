+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderLine, OrderSummary } from '#shared/types/order'
+
+/** Orders kept in server memory, keyed by id. Lost on restart. */
+const orders = new Map<string, Order>()
+
+/** Validates the body and returns the lines, throwing 400 on bad input. */
+export function parseOrderLines(lines: unknown): CartLine[] {
+  if (!Array.isArray(lines) || lines.length === 0) {
+    throw createError({ statusCode: 400, statusMessage: 'lines must be a non-empty array' })
+  }
+  return lines.map((line) => {
+    const slug = (line as CartLine | null)?.slug
+    const qty = (line as CartLine | null)?.qty
+    if (typeof slug !== 'string' || !findProduct(slug)) {
+      throw createError({ statusCode: 400, statusMessage: `unknown product: ${String(slug)}` })
+    }
+    if (!Number.isInteger(qty) || (qty as number) < 1) {
+      throw createError({ statusCode: 400, statusMessage: `invalid qty for ${slug}` })
+    }
+    return { slug, qty: qty as number }
+  })
+}
+
+/** Stores an order with amounts charged by the server. */
+export function createOrder(lines: CartLine[], code?: string): OrderSummary {
+  const priced = priceLines(lines, code)
+  const order: Order = {
+    id: crypto.randomUUID(),
+    subtotal: formatMoney(priced.subtotal),
+    discount: formatMoney(priced.discount),
+    total: formatMoney(priced.total),
+    lines: lines.map<OrderLine>(line => ({ slug: line.slug, qty: line.qty, name: findProduct(line.slug)!.name })),
+  }
+  orders.set(order.id, order)
+  return summaryOf(order)
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
+
+export function summaryOf(order: OrderSummary): OrderSummary {
+  return { id: order.id, subtotal: order.subtotal, discount: order.discount, total: order.total }
+}
