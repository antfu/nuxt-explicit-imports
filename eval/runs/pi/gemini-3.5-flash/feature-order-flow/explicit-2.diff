@@ -0,0 +1,18 @@
+import type { CartLine } from '#shared/types/cart'
+import { defineEventHandler, readBody, createError } from 'h3'
+import { computeQuote } from '#server/utils/quote'
+import { createOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  if (!body || !body.lines) {
+    throw createError({
+      statusCode: 400,
+      statusMessage: 'Invalid order request: lines are required',
+    })
+  }
+
+  const quote = computeQuote(body.lines, body.code)
+  const order = createOrder(body.lines, quote.subtotal, quote.discount, quote.total)
+  return order
+})
