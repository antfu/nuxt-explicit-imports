new file mode 100644
index 0000000..aaccbda
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,41 @@
+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import type { Product } from '#shared/types/product'
+import { useRoute, useFetch, useNuxtData } from '#app'
+import { computed } from 'vue'
+import { useProducts } from '~/composables/useProducts'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+
+// Fetch products list to look up names
+await useProducts()
+const { data: products } = useNuxtData<Product[]>('products')
+
+// Fetch the order
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+function getProductName(slug: string): string {
+  const product = products.value?.find(p => p.slug === slug)
+  return product ? product.name : slug
+}
+
+const displayTotal = computed(() => {
+  if (!order.value?.total) return ''
+  // Extract number from server total e.g. "19.99 USD" -> 19.99
+  const val = parseFloat(order.value.total)
+  return formatMoney(Math.round(val * 100))
+})
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ getProductName(line.slug) }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ displayTotal }}</span></p>
+  </div>
+</template>
