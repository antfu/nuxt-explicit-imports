@@ -0,0 +1,43 @@
+<script setup lang="ts">
+import { computed } from 'vue'
+import { useRoute, useFetch } from '#imports'
+import { useProducts } from '~/composables/useProducts'
+import type { CartLine } from '#shared/types/cart'
+
+interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: CartLine[]
+}
+
+const route = useRoute()
+const orderId = route.params.id as string
+
+const { data: order, error } = await useFetch<Order>(`/api/orders/${orderId}`)
+const { data: products } = await useProducts()
+
+const displayTotal = computed(() => {
+  if (!order.value?.total) return ''
+  return '$' + order.value.total.replace(/\s*USD\s*/i, '')
+})
+</script>
+
+<template>
+  <div>
+    <h1>Order Details</h1>
+    <div v-if="error">
+      <p>Error loading order.</p>
+    </div>
+    <div v-else-if="order">
+      <h2>Order #{{ order.id }}</h2>
+      <ul>
+        <li v-for="line in order.lines" :key="line.slug" class="order-line">
+          {{ products?.find(p => p.slug === line.slug)?.name ?? line.slug }}
+        </li>
+      </ul>
+      <p>Total: <span id="order-total">{{ displayTotal }}</span></p>
+    </div>
+  </div>
+</template>
