@@ -0,0 +1,44 @@
+<script setup lang="ts">
+interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: { slug: string; qty: number }[]
+  code?: string
+}
+
+const route = useRoute()
+const id = route.params.id as string
+
+const { data: order } = await useFetch<Order>(`/api/orders/${id}`)
+const { data: products } = await useProducts()
+
+function parseServerMoneyToCents(moneyStr: string): number {
+  if (!moneyStr) return 0
+  const val = parseFloat(moneyStr.replace(' USD', ''))
+  return Math.round(val * 100)
+}
+
+function getProductName(slug: string): string {
+  const product = products.value?.find(p => p.slug === slug)
+  return product ? product.name : slug
+}
+</script>
+
+<template>
+  <div>
+    <h1>Order Summary</h1>
+    <div v-if="order">
+      <ul>
+        <li v-for="line in order.lines" :key="line.slug" class="order-line">
+          {{ getProductName(line.slug) }}
+        </li>
+      </ul>
+      <p>Total: <span id="order-total">{{ formatMoney(parseServerMoneyToCents(order.total)) }}</span></p>
+    </div>
+    <div v-else>
+      <p>Order not found</p>
+    </div>
+  </div>
+</template>
