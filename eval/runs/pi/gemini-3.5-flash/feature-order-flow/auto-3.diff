+import type { CartLine } from '#shared/types/cart'
+
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: CartLine[]
+  code?: string
+}
+
+const orders: Order[] = []
+let nextOrderId = 1
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const quote = computeQuote(lines, code)
+  const id = String(nextOrderId++)
+  const order: Order = {
+    id,
+    ...quote,
+    lines,
+    code,
+  }
+  orders.push(order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.find(o => o.id === id)
+}
