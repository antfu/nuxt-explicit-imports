+<script setup lang="ts">
+import { useRoute, useFetch } from '#imports'
+import { formatMoney } from '~/utils/money'
+
+interface OrderLine {
+  slug: string
+  qty: number
+  name: string
+}
+
+interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+function parseToCents(moneyStr: string): number {
+  const amountStr = moneyStr.split(' ')[0] ?? '0'
+  return Math.round(parseFloat(amountStr) * 100)
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ formatMoney(parseToCents(order.total)) }}</span></p>
+  </div>
+</template>
