+import type { CartLine } from '#shared/types/cart'
+import { computeQuote } from '#server/utils/quote'
+import { findProduct } from '#server/utils/db'
+
+export interface OrderLine {
+  slug: string
+  qty: number
+  name: string
+}
+
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
+
+const ordersStore = new Map<string, Order>()
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const quote = computeQuote(lines, code)
+  const id = crypto.randomUUID()
+  
+  const orderLines: OrderLine[] = lines.map(line => {
+    const product = findProduct(line.slug)
+    return {
+      slug: line.slug,
+      qty: line.qty,
+      name: product?.name ?? line.slug,
+    }
+  })
+
+  const order: Order = {
+    id,
+    subtotal: quote.subtotal,
+    discount: quote.discount,
+    total: quote.total,
+    lines: orderLines,
+  }
+
+  ordersStore.set(id, order)
+  return order
+}
+
+export function getOrder(id: string): Order | undefined {
+  return ordersStore.get(id)
+}
