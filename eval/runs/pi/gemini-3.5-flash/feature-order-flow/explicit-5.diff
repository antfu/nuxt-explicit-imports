@@ -0,0 +1,44 @@
+<script setup lang="ts">
+import { useRoute, useFetch } from '#app'
+import { computed } from 'vue'
+import { formatMoney } from '~/utils/money'
+
+interface OrderLine {
+  slug: string
+  qty: number
+  name: string
+}
+
+interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+
+const formattedTotal = computed(() => {
+  if (!order.value?.total) return ''
+  const cents = Math.round(parseFloat(order.value.total) * 100)
+  return formatMoney(cents)
+})
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order Details</h1>
+    <p>Order ID: {{ order.id }}</p>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }} (x{{ line.qty }})
+      </li>
+    </ul>
+    <p>Total Charged: <span id="order-total">{{ formattedTotal }}</span></p>
+  </div>
+  <div v-else>
+    <p>Loading order...</p>
+  </div>
+</template>
