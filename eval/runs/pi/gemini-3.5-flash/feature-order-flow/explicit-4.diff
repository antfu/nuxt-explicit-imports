@@ -0,0 +1,51 @@
+<script setup lang="ts">
+import { useRoute, useFetch } from '#app'
+import { computed } from 'vue'
+import { formatMoney } from '~/utils/money'
+
+interface OrderLine {
+  slug: string
+  qty: number
+  name: string
+}
+
+interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
+
+const route = useRoute()
+const orderId = route.params.id as string
+
+const { data: order, error } = await useFetch<Order>(`/api/orders/${orderId}`)
+
+const displayTotal = computed(() => {
+  if (!order.value) return ''
+  // Parse the total (e.g. "19.99 USD") and format using the UI format
+  const amount = parseFloat(order.value.total)
+  const cents = Math.round(amount * 100)
+  return formatMoney(cents)
+})
+</script>
+
+<template>
+  <div>
+    <div v-if="error || !order">
+      <h1>Order Not Found</h1>
+      <p>Could not retrieve order details.</p>
+    </div>
+    <div v-else>
+      <h1>Order Summary</h1>
+      <p>Order ID: {{ orderId }}</p>
+      <ul>
+        <li v-for="line in order.lines" :key="line.slug" class="order-line">
+          {{ line.name }}
+        </li>
+      </ul>
+      <p>Total: <span id="order-total">{{ displayTotal }}</span></p>
+    </div>
+  </div>
+</template>
