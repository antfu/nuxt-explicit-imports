diff --git a/app/pages/orders/[id].vue b/app/pages/orders/[id].vue
new file mode 100644
index 0000000..318d3cb
--- /dev/null
+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,33 @@
+<script setup lang="ts">
+import { useRoute, useFetch } from '#imports'
+import type { Order } from '#shared/types/order'
+import { useProducts } from '~/composables/useProducts'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const orderId = route.params.id as string
+
+const { data: order } = await useFetch<Order>(`/api/orders/${orderId}`)
+const { data: products } = await useProducts()
+
+function formatOrderTotal(totalStr: string) {
+  const value = parseFloat(totalStr)
+  if (isNaN(value)) return ''
+  return formatMoney(Math.round(value * 100))
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ products?.find(p => p.slug === line.slug)?.name ?? line.slug }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ formatOrderTotal(order.total) }}</span></p>
+  </div>
+  <div v-else>
+    <p>Order not found</p>
+  </div>
+</template>
diff --git a/server/api/orders.post.ts b/server/api/orders.post.ts
new file mode 100644
index 0000000..1df8771
--- /dev/null
+++ b/server/api/orders.post.ts
@@ -0,0 +1,20 @@
+import type { CartLine } from '#shared/types/cart'
+import { defineEventHandler, readBody } from 'h3'
+import { computeQuote } from '#server/utils/quote'
+import { saveOrder, generateOrderId } from '#server/utils/db'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const id = generateOrderId()
+  const lines = body?.lines ?? []
+  const quote = computeQuote(lines, body?.code)
+  const order = {
+    id,
+    subtotal: quote.subtotal,
+    discount: quote.discount,
+    total: quote.total,
+    lines,
+  }
+  saveOrder(order)
+  return order
+})
diff --git a/server/api/orders/[id].get.ts b/server/api/orders/[id].get.ts
new file mode 100644
index 0000000..fada287
--- /dev/null
+++ b/server/api/orders/[id].get.ts
@@ -0,0 +1,14 @@
+import { createError, defineEventHandler, getRouterParam } from 'h3'
+import { getOrder } from '#server/utils/db'
+
+export default defineEventHandler((event) => {
+  const id = getRouterParam(event, 'id') ?? ''
+  const order = getOrder(id)
+  if (!order) {
+    throw createError({
+      statusCode: 404,
+      statusMessage: 'Order not found',
+    })
+  }
+  return order
+})
