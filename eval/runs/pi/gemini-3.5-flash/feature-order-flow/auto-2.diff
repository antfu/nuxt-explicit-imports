@@ -0,0 +1,37 @@
+<script setup lang="ts">
+const route = useRoute()
+const orderId = route.params.id as string
+
+const { data: order } = await useFetch(`/api/orders/${orderId}`)
+const { data: products } = await useProducts()
+
+const getProductName = (slug: string) => {
+  const product = products.value?.find(p => p.slug === slug)
+  return product ? product.name : slug
+}
+
+const formattedTotal = computed(() => {
+  if (!order.value?.total) return ''
+  const numericValue = parseFloat(order.value.total)
+  if (isNaN(numericValue)) return order.value.total
+  return formatMoney(Math.round(numericValue * 100))
+})
+</script>
+
+<template>
+  <div>
+    <h1>Order Details</h1>
+    <div v-if="order">
+      <p>Order ID: {{ orderId }}</p>
+      <ul>
+        <li v-for="line in order.lines" :key="line.slug" class="order-line">
+          {{ getProductName(line.slug) }}
+        </li>
+      </ul>
+      <p>Total: <span id="order-total">{{ formattedTotal }}</span></p>
+    </div>
+    <p v-else>
+      Order not found.
+    </p>
+  </div>
+</template>
