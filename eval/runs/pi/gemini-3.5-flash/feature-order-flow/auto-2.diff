 }
+
+const orders: Record<string, Order> = {}
+let nextOrderId = 1000
+
+export function saveOrder(orderData: Omit<Order, 'id'>): Order {
+  nextOrderId++
+  const id = String(nextOrderId)
+  const saved: Order = { ...orderData, id }
+  orders[id] = saved
+  return saved
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders[id]
+}
