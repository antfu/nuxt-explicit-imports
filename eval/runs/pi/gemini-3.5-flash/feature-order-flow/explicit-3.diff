@@ -0,0 +1,44 @@
+import type { CartLine } from '#shared/types/cart'
+import { findProduct } from '#server/utils/db'
+import { computeQuote } from '#server/utils/quote'
+
+export interface OrderLine {
+  slug: string
+  qty: number
+  name: string
+}
+
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
+
+const orders: Order[] = []
+let nextId = 1
+
+export function saveOrder(lines: CartLine[], code?: string): Order {
+  const id = String(nextId++)
+  const orderLines = lines.map(line => {
+    const product = findProduct(line.slug)
+    return {
+      slug: line.slug,
+      qty: line.qty,
+      name: product?.name ?? line.slug,
+    }
+  })
+  const quote = computeQuote(lines, code)
+  const order: Order = {
+    id,
+    ...quote,
+    lines: orderLines,
+  }
+  orders.push(order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.find(o => o.id === id)
+}
