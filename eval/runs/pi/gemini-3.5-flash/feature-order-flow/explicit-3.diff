+import type { CartLine } from '#shared/types/cart'
+
+export interface Order {
+  id: string
+  lines: CartLine[]
+  subtotal: string
+  discount: string
+  total: string
+}
+
+const orders = new Map<string, Order>()
+let nextId = 1
+
+export function createOrder(lines: CartLine[], subtotal: string, discount: string, total: string): Order {
+  const id = String(nextId++)
+  const order: Order = {
+    id,
+    lines,
+    subtotal,
+    discount,
+    total,
+  }
+  orders.set(id, order)
+  return order
+}
+
+export function getOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
