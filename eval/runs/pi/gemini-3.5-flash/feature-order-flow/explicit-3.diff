@@ -0,0 +1,33 @@
+<script setup lang="ts">
+import { computed } from 'vue'
+import { useFetch, useRoute } from '#imports'
+import { formatMoney } from '~/utils/money'
+
+const route = useRoute()
+const { data: order } = await useFetch<{
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: { slug: string; qty: number; name: string }[]
+}>(`/api/orders/${route.params.id}`)
+
+const formattedTotal = computed(() => {
+  if (!order.value)
+    return ''
+  const cents = Math.round(parseFloat(order.value.total) * 100)
+  return formatMoney(cents)
+})
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ line.name }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ formattedTotal }}</span></p>
+  </div>
+</template>
