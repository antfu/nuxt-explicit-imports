+<script setup lang="ts">
+import { useRoute, useFetch } from '#app'
+import { useProducts } from '~/composables/useProducts'
+import { formatMoney } from '~/utils/money'
+import { computed } from 'vue'
+
+interface ServerOrder {
+  id: string
+  lines: { slug: string, qty: number }[]
+  subtotal: string
+  discount: string
+  total: string
+}
+
+const route = useRoute()
+const { data: order } = await useFetch<ServerOrder>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+
+function getProductName(slug: string) {
+  const product = products.value?.find(p => p.slug === slug)
+  return product ? product.name : slug
+}
+
+const formattedTotal = computed(() => {
+  if (!order.value?.total) return ''
+  const cents = Math.round(parseFloat(order.value.total) * 100)
+  return formatMoney(cents)
+})
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order #{{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ getProductName(line.slug) }} x{{ line.qty }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ formattedTotal }}</span></p>
+  </div>
+  <div v-else>
+    Loading order...
+  </div>
+</template>
