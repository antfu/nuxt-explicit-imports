+<script setup lang="ts">
+interface OrderLine {
+  slug: string
+  qty: number
+  name: string
+}
+
+interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
+
+const route = useRoute()
+const orderId = route.params.id as string
+
+const { data: order } = await useFetch<Order>(`/api/orders/${orderId}`)
+
+const formattedTotal = computed(() => {
+  if (!order.value) return ''
+  const parsed = parseFloat(order.value.total)
+  if (isNaN(parsed)) return order.value.total
+  return formatMoney(Math.round(parsed * 100))
+})
+</script>
+
+<template>
+  <div>
+    <h1>Order #{{ orderId }}</h1>
+    <div v-if="order">
+      <ul>
+        <li v-for="line in order.lines" :key="line.slug" class="order-line">
+          {{ line.name }}
+        </li>
+      </ul>
+      <p>Total: <span id="order-total">{{ formattedTotal }}</span></p>
+    </div>
+    <div v-else>
+      <p>Order not found.</p>
+    </div>
+  </div>
+</template>
