+import type { CartLine } from '#shared/types/cart'
+
+export interface OrderLine {
+  slug: string
+  qty: number
+  name: string
+}
+
+export interface Order {
+  id: string
+  subtotal: string
+  discount: string
+  total: string
+  lines: OrderLine[]
+}
+
+const orders = new Map<string, Order>()
+let nextOrderId = 1
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const quote = computeQuote(lines, code)
+
+  const orderLines: OrderLine[] = lines.map(line => {
+    const product = findProduct(line.slug)
+    return {
+      slug: line.slug,
+      qty: line.qty,
+      name: product?.name ?? line.slug,
+    }
+  })
+
+  const order: Order = {
+    id: String(nextOrderId++),
+    subtotal: quote.subtotal,
+    discount: quote.discount,
+    total: quote.total,
+    lines: orderLines,
+  }
+
+  orders.set(order.id, order)
+  return order
+}
+
+export function findOrder(id: string): Order | undefined {
+  return orders.get(id)
+}
