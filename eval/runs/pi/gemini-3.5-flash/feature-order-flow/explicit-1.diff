diff --git a/server/api/orders.post.ts b/server/api/orders.post.ts
new file mode 100644
index 0000000..2fed72c
--- /dev/null
+++ b/server/api/orders.post.ts
@@ -0,0 +1,36 @@
+import type { CartLine } from '#shared/types/cart'
+import type { Order, OrderLine } from '#shared/types/order'
+import { defineEventHandler, readBody } from 'h3'
+import { computeQuote } from '#server/utils/quote'
+import { findProduct } from '#server/utils/db'
+import { saveOrder } from '#server/utils/orders'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const lines = body?.lines ?? []
+  const code = body?.code
+  
+  const quote = computeQuote(lines, code)
+  const id = Math.random().toString(36).substring(2, 11)
+  
+  const orderLines: OrderLine[] = lines.map(line => {
+    const product = findProduct(line.slug)
+    return {
+      slug: line.slug,
+      qty: line.qty,
+      name: product?.name ?? line.slug,
+    }
+  })
+  
+  const order: Order = {
+    id,
+    subtotal: quote.subtotal,
+    discount: quote.discount,
+    total: quote.total,
+    lines: orderLines,
+  }
+  
+  saveOrder(order)
+  
+  return order
+})
diff --git a/server/api/orders/[id].get.ts b/server/api/orders/[id].get.ts
new file mode 100644
index 0000000..e2b6244
--- /dev/null
+++ b/server/api/orders/[id].get.ts
@@ -0,0 +1,11 @@
+import { defineEventHandler, getRouterParam, createError } from 'h3'
+import { getOrder } from '#server/utils/orders'
+
+export default defineEventHandler((event) => {
+  const id = getRouterParam(event, 'id') ?? ''
+  const order = getOrder(id)
+  if (!order) {
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  }
+  return order
+})
diff --git a/server/utils/orders.ts b/server/utils/orders.ts
