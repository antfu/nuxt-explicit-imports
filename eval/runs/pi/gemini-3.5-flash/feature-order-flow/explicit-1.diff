+++ b/app/pages/orders/[id].vue
@@ -0,0 +1,29 @@
+<script setup lang="ts">
+import type { Order } from '#shared/types/order'
+import { useRoute, useFetch } from '#imports'
+import { useProducts } from '~/composables/useProducts'
+
+const route = useRoute()
+const { data: order } = await useFetch<Order>(`/api/orders/${route.params.id}`)
+const { data: products } = await useProducts()
+
+function getProductName(slug: string): string {
+  const product = products.value?.find(p => p.slug === slug)
+  return product ? product.name : slug
+}
+</script>
+
+<template>
+  <div v-if="order">
+    <h1>Order {{ order.id }}</h1>
+    <ul>
+      <li v-for="line in order.lines" :key="line.slug" class="order-line">
+        {{ getProductName(line.slug) }}
+      </li>
+    </ul>
+    <p>Total: <span id="order-total">{{ order.total }}</span></p>
+  </div>
+  <div v-else>
+    <p>Order not found</p>
+  </div>
+</template>
diff --git a/server/api/orders.post.ts b/server/api/orders.post.ts
new file mode 100644
index 0000000..69fb738
--- /dev/null
+++ b/server/api/orders.post.ts
@@ -0,0 +1,33 @@
+import { defineEventHandler, readBody } from 'h3'
+import { computeQuote } from '#server/utils/quote'
+import { saveOrder } from '#server/utils/db'
+import type { Order } from '#shared/types/order'
+import type { CartLine } from '#shared/types/cart'
+
+export default defineEventHandler(async (event) => {
+  const body = await readBody<{ lines?: CartLine[], code?: string }>(event)
+  const lines = body?.lines ?? []
+  const code = body?.code
+
+  const quote = computeQuote(lines, code)
+
+  const id = Date.now().toString(36) + Math.random().toString(36).substring(2, 6)
+
+  const order: Order = {
+    id,
+    subtotal: quote.subtotal,
+    discount: quote.discount,
+    total: quote.total,
+    lines,
+  }
+
+  saveOrder(order)
+
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+    lines: order.lines,
+  }
+})
diff --git a/server/api/orders/[id].get.ts b/server/api/orders/[id].get.ts
new file mode 100644
index 0000000..f713dd2
--- /dev/null
+++ b/server/api/orders/[id].get.ts
@@ -0,0 +1,17 @@
+import { createError, defineEventHandler, getRouterParam } from 'h3'
+import { findOrder } from '#server/utils/db'
+
+export default defineEventHandler((event) => {
+  const id = getRouterParam(event, 'id') ?? ''
+  const order = findOrder(id)
+  if (!order) {
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  }
+  return {
+    id: order.id,
+    subtotal: order.subtotal,
+    discount: order.discount,
+    total: order.total,
+    lines: order.lines,
+  }
+})
