+import type { CartLine } from '#shared/types/cart'
+
+export interface Order extends Quote {
+  id: string
+}
+
+const orders = new Map<string, { order: Order, lines: CartLine[] }>()
+
+export function createOrder(lines: CartLine[], code?: string): Order {
+  const order: Order = { id: crypto.randomUUID(), ...computeQuote(lines, code) }
+  orders.set(order.id, { order, lines: lines.map(l => ({ slug: l.slug, qty: l.qty })) })
+  return order
+}
+
+export function getOrder(id: string) {
+  const entry = orders.get(id)
+  if (!entry)
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  return entry
+}
