+import { createError, defineEventHandler, getRouterParam } from 'h3'
+import { findOrder } from '#server/utils/orders'
+import { findProduct } from '#server/utils/db'
+
+export default defineEventHandler((event) => {
+  const found = findOrder(getRouterParam(event, 'id') ?? '')
+  if (!found)
+    throw createError({ statusCode: 404, statusMessage: 'Order not found' })
+  return found.lines.map(l => ({ slug: l.slug, qty: l.qty, name: findProduct(l.slug)?.name ?? l.slug }))
+})
