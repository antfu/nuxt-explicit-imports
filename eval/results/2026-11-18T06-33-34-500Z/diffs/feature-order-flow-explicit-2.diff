+import type { CartLine } from '#shared/types/cart'
+import { computeQuoteCents, formatQuote } from '#server/utils/quote'
+import type { Quote } from '#server/utils/quote'
+import { findProduct } from '#server/utils/db'
+
+interface StoredOrder {
+  id: string
+  lines: CartLine[]
+  totalCents: number
+  quote: Quote
+}
+
+const orders = new Map<string, StoredOrder>()
+let counter = 0
+
+export function createOrder(lines: CartLine[], code?: string): Quote & { id: string } {
+  const cents = computeQuoteCents(lines, code)
+  const id = String(++counter)
+  const quote = formatQuote(cents)
+  orders.set(id, { id, lines: lines.map(l => ({ slug: l.slug, qty: l.qty })), totalCents: cents.total, quote })
+  return { id, ...quote }
+}
+
+export function getOrder(id: string) {
+  const order = orders.get(id)
+  if (!order)
+    return undefined
+  return {
+    id: order.id,
+    ...order.quote,
+    totalCents: order.totalCents,
+    lines: order.lines.map(l => ({ ...l, name: findProduct(l.slug)?.name ?? l.slug })),
+  }
+}
